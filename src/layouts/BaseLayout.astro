---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonicalSlug?: string;
  jsonLd?: object[];
  examName?: string;
  category?: string;
}

const { title, description, canonicalSlug = '', jsonLd = [], examName, category } = Astro.props;
const siteUrl = (Astro.site ? Astro.site.toString() : (process.env.PUBLIC_SITE_URL || 'https://uploadright.pages.dev')).replace(/\/$/, '');
const canonicalUrl = `${siteUrl}/${canonicalSlug}`.replace(/\/$/, '') || siteUrl;

// Build breadcrumb JSON-LD
const breadcrumbItems: any[] = [
  { "@type": "ListItem", position: 1, name: "Home", item: siteUrl }
];
if (category) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: 2,
    name: category,
    item: `${siteUrl}/#${category}`
  });
}
if (examName) {
  breadcrumbItems.push({
    "@type": "ListItem",
    position: breadcrumbItems.length + 1,
    name: examName,
    item: canonicalUrl
  });
}

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbItems
};

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "UploadRight",
  "applicationCategory": "UtilitiesApplication",
  "operatingSystem": "Any",
  "url": siteUrl,
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "INR"
  },
  "description": "Free online tool to resize photos, signatures, and documents for Indian government exams and portals. 100% client-side, privacy-first."
};

const allSchemas = [breadcrumbSchema, softwareSchema, ...jsonLd];
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />

  <title>{title}</title>

  <link rel="canonical" href={canonicalUrl} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="UploadRight" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />

  <!-- Google Fonts: Inter, Plus Jakarta Sans & Geist Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

  <!-- JSON-LD Structured Data -->
  {allSchemas.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

</head>
<body class="bg-white text-black font-sans antialiased min-h-screen flex flex-col selection:bg-black selection:text-white">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-black focus:text-white focus:rounded-full text-xs font-semibold">Skip to main content</a>

  <slot name="header" />

  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <slot name="footer" />
</body>
</html>
