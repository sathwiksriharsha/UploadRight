---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedToolsGrid from '../components/RelatedToolsGrid.astro';
import presets from '../data/presets.json';

const title = "Supported Exams & Official Dimension Guidelines (46+ Portals) | UploadRight";
const description = "Complete directory of 46+ supported Indian government and competitive exams with official photo, signature, and thumb impression specifications.";
---

<BaseLayout title={title} description={description} canonicalSlug="supported">
  <Header slot="header" />

  <main class="py-8 sm:py-12 bg-white">
    <!-- Breadcrumb & Header -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 mb-8 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-neutral-500 font-mono" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black transition-colors">Home</a>
        <span>/</span>
        <span class="text-black font-semibold" aria-current="page">Supported Exams</span>
      </nav>

      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#dceeb1] text-black border border-black/10 font-mono text-xs font-bold shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#1ea64a]"></span>
          <span>Official 2026 Recruitment Directory ({presets.length}+ Portals)</span>
        </div>
        <h1 class="text-3xl sm:text-6xl font-black text-black tracking-tight leading-tight">
          Supported Exam <span class="underline decoration-4 decoration-black">Portals &amp; Requirements</span>
        </h1>
        <p class="text-base sm:text-lg text-neutral-600 max-w-2xl leading-relaxed">
          Explore all {presets.length}+ supported competitive examinations with verified pixel dimensions, physical centimeter sizes, KB windows, and official notices.
        </p>
      </div>
    </section>

    <!-- The Figma Lime Container with Clean White Cards -->
    <RelatedToolsGrid showAll={true} />
  </main>

  <Footer slot="footer" />
</BaseLayout>

