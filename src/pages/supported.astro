---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import RelatedToolsGrid from '../components/RelatedToolsGrid.astro';
import presets from '../data/presets.json';

const title = "Supported Exams & Official Dimension Guidelines (44+ Portals) | UploadRight";
const description = "Complete directory of 44+ supported Indian government and competitive exams with official photo, signature, and thumb impression specifications.";
---

<BaseLayout title={title} description={description} canonicalSlug="supported">
  <Header slot="header" />

  <div class="relative bg-white py-12 sm:py-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 space-y-8">
      <div class="text-center max-w-3xl mx-auto space-y-4">
        <span class="inline-block px-3.5 py-1 rounded-full text-xs font-mono font-semibold bg-[#dceeb1] text-black border border-black/10">
          EXAMINATION DIRECTORY
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight leading-tight">
          Supported Exam <span class="text-[#0062FF]">Portals &amp; Requirements</span>
        </h1>
        <p class="text-base text-neutral-600 max-w-2xl mx-auto leading-relaxed">
          Explore all 44+ supported competitive examinations with verified pixel dimensions, physical centimeter sizes, KB windows, and official notices.
        </p>
      </div>

      <RelatedToolsGrid showAll={true} />
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
