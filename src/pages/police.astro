---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExamToolWorkspace from '../components/ExamToolWorkspace.astro';
import presets from '../data/presets.json';

const policePresets = presets.filter(p => p.slug.includes('police') || p.slug.includes('gd'));

const title = "Police Constable & SI Photo & Signature Resizers — UP, Delhi, Bihar Police | UploadRight";
const description = "Free online image resizer for Police recruitment exams: UP Police, Delhi Police Constable/SI, SSC GD, and State Police. Exact 3.5×4.5 cm and 20–50 KB specifications.";
---

<BaseLayout title={title} description={description} canonicalSlug="police">
  <Header slot="header" />

  <div class="relative bg-white py-10 sm:py-16">
    <!-- Hero Header -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-8 sm:mb-12 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-[#86868B]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1D1D1F] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#1D1D1F] font-medium" aria-current="page">Police Exams</span>
      </nav>

      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F5F5F7] border border-[#E5E5EA] text-xs font-semibold text-[#1D1D1F]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0062FF]"></span>
          <span>Police Constable &amp; SI Recruitment Hub</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#1D1D1F] tracking-tight leading-tight">
          Police Constable &amp; SI <span class="text-[#0062FF]">Image Resizers</span>
        </h1>
        <p class="text-sm sm:text-base text-[#86868B] max-w-2xl leading-relaxed">
          Format candidate photographs and signatures for UP Police Constable, Delhi Police Executive, SSC GD Constable, and state police recruitment boards.
        </p>
      </div>
    </section>

    <!-- Studio Workspace -->
    <section id="studio" class="mb-16">
      <ExamToolWorkspace initialMode="preset" activePresetSlug="state-police-resizer" />
    </section>

    <!-- Police Exams Grid -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">
      <div class="space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold text-[#1D1D1F]">Police Recruitment Exams</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {policePresets.map(p => (
          <a
            href={`/${p.slug}`}
            class="p-5 rounded-2xl border border-[#E5E5EA] bg-[#F5F5F7] hover:bg-[#EBF2FF] hover:border-[#0062FF]/40 transition-all group space-y-2"
          >
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-[#0062FF]">{p.exam}</span>
              <span class="text-[#86868B] group-hover:text-[#0062FF] transition-colors">→</span>
            </div>
            <h3 class="text-sm font-bold text-[#1D1D1F] group-hover:text-[#0062FF] transition-colors">{p.title}</h3>
            <p class="text-xs text-[#86868B] line-clamp-2">{p.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
