---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExamToolWorkspace from '../components/ExamToolWorkspace.astro';

const title = "Other Competitive Exam Photo & Signature Resizers | UploadRight";
const description = "Resize photos and signatures for NPTEL, IOCL, AAI, AIBE, FCI, Polytechnic, ITI, and other government entrance examinations.";
---

<BaseLayout title={title} description={description} canonicalSlug="others">
  <Header slot="header" />

  <div class="relative bg-white py-10 sm:py-16">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-8 sm:mb-12 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-neutral-500 font-mono uppercase" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black transition-colors">Home</a>
        <span>/</span>
        <span class="text-black font-semibold" aria-current="page">Other Exams</span>
      </nav>

      <div class="space-y-3">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#f4ecd6] text-black">
          ENTRANCE &amp; RECRUITMENT TESTS
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight leading-tight">
          Other Exam Photo &amp; Signature Resizer
        </h1>
        <p class="text-base text-neutral-600 max-w-2xl leading-relaxed">
          Photo and signature tools for NPTEL, IOCL, AAI, AIBE, FCI, Polytechnic, ITI, and specialized public sector tests.
        </p>
      </div>
    </section>

    <section id="studio" class="mb-16">
      <ExamToolWorkspace activePresetSlug="india-post-gds" />
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
