---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExamToolWorkspace from '../components/ExamToolWorkspace.astro';

const title = "Online Signature Paper Whitener & Ink Enhancer — UploadRight";
const description = "Whiten grey or shadowy signature photos to pure white background and sharpen ink. Perfect for SSC, IBPS, UPSC, and Bank portals. 100% free and private.";
---

<BaseLayout title={title} description={description} canonicalSlug="signature-whitener">
  <Header slot="header" />

  <div class="relative bg-white py-10 sm:py-16">
    <!-- Hero Header -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-8 sm:mb-12 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-[#86868B]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1D1D1F] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#1D1D1F] font-medium" aria-current="page">Signature Whitener</span>
      </nav>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#1D1D1F] tracking-tight leading-tight">
          Signature Paper <span class="text-[#0062FF]">Whitener</span>
        </h1>
        <p class="text-sm sm:text-base text-[#86868B] max-w-xl leading-relaxed">
          Snaps dull, yellow, or shadowy mobile phone photos of paper signatures into crisp, high-contrast, pure #FFFFFF backgrounds.
        </p>
      </div>
    </section>

    <!-- Studio Workspace -->
    <section id="studio" class="mb-16">
      <ExamToolWorkspace initialMode="whitener" activePresetSlug="ssc-photo-resizer" initialSlotIndex={1} />
    </section>

    <!-- How Whitener Works -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 space-y-8">
      <div class="space-y-2 text-center sm:text-left">
        <h2 class="text-xl sm:text-2xl font-bold text-[#1D1D1F] tracking-tight">
          Why Portals Reject Phone Photos of Signatures
        </h2>
        <p class="text-xs sm:text-sm text-[#86868B] max-w-xl">
          Taking a phone photo of paper under indoor lighting creates grey shadows that fail automated background threshold tests.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="p-5 rounded-2xl bg-[#F5F5F7] border border-[#E5E5EA] space-y-2">
          <span class="text-xs font-semibold text-red-500 uppercase tracking-wider block">Common Problem</span>
          <h3 class="text-sm font-bold text-[#1D1D1F]">Paper Shadow Cast</h3>
          <p class="text-xs text-[#86868B] leading-relaxed">
            Indoor lighting makes white paper register as grey (RGB 180–210) rather than pure white, causing automated rejection.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#F5F5F7] border border-[#E5E5EA] space-y-2">
          <span class="text-xs font-semibold text-[#0062FF] uppercase tracking-wider block">Our Solution</span>
          <h3 class="text-sm font-bold text-[#1D1D1F]">Luminance Snapping</h3>
          <p class="text-xs text-[#86868B] leading-relaxed">
            Our canvas filter maps near-white background pixels to #FFFFFF while preserving and darkening ink pen strokes.
          </p>
        </div>

        <div class="p-5 rounded-2xl bg-[#F5F5F7] border border-[#E5E5EA] space-y-2">
          <span class="text-xs font-semibold text-[#0062FF] uppercase tracking-wider block">Security</span>
          <h3 class="text-sm font-bold text-[#1D1D1F]">Signature Confidentiality</h3>
          <p class="text-xs text-[#86868B] leading-relaxed">
            Never upload your legal handwritten signature to third-party servers. UploadRight processes every byte strictly in your browser.
          </p>
        </div>
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
