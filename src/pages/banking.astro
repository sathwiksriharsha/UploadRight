---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ExamToolWorkspace from "../components/ExamToolWorkspace.astro";
import presets from "../data/presets.json";

// Deduplicated primary banking exam presets
const bankingSlugs = ['ibps-po', 'ibps-clerk', 'sbi-po', 'sbi-clerk', 'rbi-grade-b', 'ibps'];
const bankingPresets = bankingSlugs
  .map(slug => presets.find(p => p.slug === slug))
  .filter(Boolean) as typeof presets;

const title = "Banking Exam Photo, Signature, Thumb & Declaration Resizers — IBPS, SBI, RBI | UploadRight";
const description = "Select your banking exam: IBPS PO, IBPS Clerk, SBI PO, SBI Clerk, RBI Grade B. Complete 4-in-1 image resizer kits with verified dimensions, 200 DPI, and official handwritten declaration generator.";
---

<BaseLayout title={title} description={description} canonicalSlug="banking">
  <Header slot="header" />

  <div class="relative bg-white py-10 sm:py-16">
    <!-- Hero Header -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 mb-8 sm:mb-12 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-neutral-500 font-mono" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black transition-colors">Home</a>
        <span>/</span>
        <span class="text-black font-semibold" aria-current="page">Banking Exams</span>
      </nav>

      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#dceeb1] text-black border border-black/10 font-mono text-xs font-bold shadow-xs">
          <span class="w-2 h-2 rounded-full bg-[#1ea64a]"></span>
          <span>Official 2026 IBPS, SBI &amp; RBI Compliance Hub</span>
        </div>
        <h1 class="text-3xl sm:text-6xl font-black text-black tracking-tight leading-tight">
          Banking Exam <span class="underline decoration-4 decoration-black">Image Resizers</span>
        </h1>
        <p class="text-base sm:text-lg text-neutral-600 max-w-2xl leading-relaxed">
          Select your recruitment drive to load official 4-in-1 dimensions, KB constraints, and declaration guidelines.
        </p>
      </div>
    </section>

    <!-- Figma Color-Block Supported Exams Section (Exact Match to User Screenshot) -->
    <section class="max-w-6xl mx-auto px-4 sm:px-6 mb-16">
      <div class="bg-[#dceeb1] rounded-3xl p-8 sm:p-12 border-2 border-black space-y-8">
        <div class="space-y-2 max-w-xl">
          <span class="text-xs font-mono uppercase font-bold tracking-wider text-black block">// 2026 BANKING RECRUITMENT KITS</span>
          <h2 class="text-2xl sm:text-4xl font-black text-black tracking-tight">
            Supported Banking Exams
          </h2>
          <p class="text-sm text-neutral-800 leading-relaxed">
            Pick your target exam to open its dedicated 4-in-1 workspace with verified dimensions, KB thresholds, and declaration generator.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {bankingPresets.map((p, idx) => (
            <a
              href={`/${p.slug}`}
              class="bg-white p-6 rounded-2xl border-2 border-black space-y-4 hover:-translate-y-1 hover:shadow-md transition-all flex flex-col justify-between group cursor-pointer"
            >
              <div class="space-y-3">
                <div class="flex items-center justify-between">
                  <span class="w-8 h-8 rounded-full bg-black text-white font-mono text-sm flex items-center justify-center font-bold">
                    {idx + 1}
                  </span>
                  <span class="text-[10px] font-mono font-bold uppercase px-2.5 py-0.5 rounded-full bg-[#f7f7f5] text-black border border-[#e6e6e6]">
                    {p.slots.length}-in-1 Kit
                  </span>
                </div>

                <div>
                  <h3 class="text-base font-bold text-black group-hover:underline">
                    {p.shortTitle || p.exam}
                  </h3>
                  <p class="text-xs text-neutral-600 leading-relaxed line-clamp-2 mt-1">
                    {p.description}
                  </p>
                </div>
              </div>

              <div class="pt-3 border-t border-[#f1f1f1] flex items-center justify-between text-xs font-bold text-black font-mono">
                <span class="text-neutral-500 font-normal">{p.slots[0].dpi}&nbsp;DPI</span>
                <span class="group-hover:translate-x-1 transition-transform flex items-center gap-1">
                  Open Studio →
                </span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Studio Workspace (Pre-loaded with IBPS PO 4-in-1 Kit) -->
    <section id="studio" class="mb-16">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 mb-6">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-neutral-500 block">// INSTANT 4-IN-1 WORKSPACE</span>
        <h2 class="text-xl sm:text-2xl font-bold text-black tracking-tight">Quick Banking Studio</h2>
      </div>
      <ExamToolWorkspace initialMode="preset" activePresetSlug="ibps-po" />
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
