---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExamToolWorkspace from '../components/ExamToolWorkspace.astro';
import presets from '../data/presets.json';

const bankingPresets = presets.filter(p => p.category === 'banking' || p.slug.includes('ibps') || p.slug.includes('sbi') || p.slug.includes('rbi'));

const title = "Banking Exam Photo, Signature & Thumb Resizers — IBPS, SBI, RBI | UploadRight";
const description = "Complete 4-in-1 image resizer kits for Indian Banking Exams. Photo 200×230 px (20–50 KB), Signature 140×60 px (10–20 KB), Left Thumb 240×240 px, and Handwritten Declaration.";
---

<BaseLayout title={title} description={description} canonicalSlug="banking">
  <Header slot="header" />

  <div class="relative bg-white py-10 sm:py-16">
    <!-- Hero Header -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-8 sm:mb-12 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-[#86868B]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1D1D1F] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#1D1D1F] font-medium" aria-current="page">Banking Exams</span>
      </nav>

      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F5F5F7] border border-[#E5E5EA] text-xs font-semibold text-[#1D1D1F]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0062FF]"></span>
          <span>IBPS &amp; SBI 4-in-1 Kit Hub</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#1D1D1F] tracking-tight leading-tight">
          Banking Exam <span class="text-[#0062FF]">Image Resizers</span>
        </h1>
        <p class="text-sm sm:text-base text-[#86868B] max-w-2xl leading-relaxed">
          Full compliance with IBPS and SBI CRP guidelines: candidate photograph, black-ink signature, left thumb impression, and official handwritten declaration in a single session.
        </p>
      </div>
    </section>

    <!-- Studio Workspace -->
    <section id="studio" class="mb-16">
      <ExamToolWorkspace initialMode="preset" activePresetSlug="ibps-photo-signature-resizer" />
    </section>

    <!-- Banking Exams Grid -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">
      <div class="space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold text-[#1D1D1F]">Supported Banking &amp; Insurance Exams</h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {bankingPresets.map(p => (
          <a
            href={`/${p.slug}`}
            class="p-5 rounded-2xl border border-[#E5E5EA] bg-[#F5F5F7] hover:bg-[#EBF2FF] hover:border-[#0062FF]/40 transition-all group space-y-2"
          >
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-[#0062FF]">{p.exam}</span>
              <span class="text-[#86868B] group-hover:text-[#0062FF] transition-colors">→</span>
            </div>
            <h3 class="text-sm font-bold text-[#1D1D1F] group-hover:text-[#0062FF] transition-colors">{p.title}</h3>
            <p class="text-xs text-[#86868B] line-clamp-2">{p.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
