---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = "Terms of Service — UploadRight";
const description = "Terms of Service for using UploadRight. Free in-browser client-side image resizing and compression.";
---

<BaseLayout title={title} description={description} canonicalSlug="terms-of-service">
  <Header slot="header" />

  <div class="relative bg-white py-12 sm:py-20">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 space-y-8">
      <h1 class="text-3xl sm:text-4xl font-black text-black">Terms of Service</h1>
      <div class="prose prose-neutral max-w-none text-sm sm:text-base leading-relaxed space-y-4">
        <p>Last updated: 2026</p>
        <p>By using UploadRight, you agree to these Terms of Service. UploadRight provides client-side in-browser image formatting and compression for educational and job application purposes.</p>
        <h2 class="text-xl font-bold text-black mt-6">1. In-Browser Privacy</h2>
        <p>All processing occurs strictly inside your web browser. No photos, signatures, or documents are transmitted to our servers or stored in any database.</p>
        <h2 class="text-xl font-bold text-black mt-6">2. Verification Disclaimer</h2>
        <p>While UploadRight conforms to official notifications, candidates should review their official recruitment portal guidelines prior to submitting final applications.</p>
      </div>
    </div>
  </div>

  <Footer slot="footer" />
</BaseLayout>
