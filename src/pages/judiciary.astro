---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExamToolWorkspace from '../components/ExamToolWorkspace.astro';
import presets from '../data/presets.json';

const title = "Judiciary Exam Photo & Signature Resizers — High Court & Civil Judge | UploadRight";
const description = "Resize and format photos, signatures, and document uploads for Delhi Judicial Service (DJS), Patna HC, Bombay HC, MP Judiciary, and State High Courts.";
---

<BaseLayout title={title} description={description} canonicalSlug="judiciary">
  <Header slot="header" />

  <div class="relative bg-white py-10 sm:py-16">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-8 sm:mb-12 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-neutral-500 font-mono uppercase" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black transition-colors">Home</a>
        <span>/</span>
        <span class="text-black font-semibold" aria-current="page">Judiciary Exams</span>
      </nav>

      <div class="space-y-3">
        <span class="inline-block px-3 py-1 rounded-full text-xs font-mono font-semibold bg-[#c5b0f4] text-black">
          HIGH COURT &amp; JUDICIAL SERVICES
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight leading-tight">
          Judiciary Exam Photo &amp; Signature Resizer
        </h1>
        <p class="text-base text-neutral-600 max-w-2xl leading-relaxed">
          Official dimensions and strict KB thresholds for Delhi Judicial Services (DJS), High Court Clerks, Stenographers, and State Judicial exams.
        </p>
      </div>
    </section>

    <section id="studio" class="mb-16">
      <ExamToolWorkspace activePresetSlug="upsc" />
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
