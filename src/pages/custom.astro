---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExamToolWorkspace from '../components/ExamToolWorkspace.astro';

const title = "Custom Image Resizer & KB Compressor — UploadRight";
const description = "Set exact width, height in px, cm, mm, inch and compress strictly within minimum and maximum KB thresholds. 100% private in-browser.";
---

<BaseLayout title={title} description={description} canonicalSlug="custom">
  <Header slot="header" />

  <div class="relative bg-white py-10 sm:py-16">
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-8 sm:mb-12 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-neutral-500 font-mono uppercase" aria-label="Breadcrumb">
        <a href="/" class="hover:text-black transition-colors">Home</a>
        <span>/</span>
        <span class="text-black font-semibold" aria-current="page">Custom Resizer</span>
      </nav>

      <div class="space-y-3">
        <h1 class="text-3xl sm:text-5xl font-black text-black tracking-tight leading-tight">
          Custom Dimensions &amp; KB Resizer
        </h1>
        <p class="text-base text-neutral-600 max-w-xl leading-relaxed">
          Specify custom width, height, unit (px, cm, mm, inch), KB thresholds, and DPI.
        </p>
      </div>
    </section>

    <section id="studio" class="mb-16">
      <ExamToolWorkspace initialMode="custom" />
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
