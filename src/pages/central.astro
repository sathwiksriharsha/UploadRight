---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ExamToolWorkspace from '../components/ExamToolWorkspace.astro';
import presets from '../data/presets.json';

const centralPresets = presets.filter(p => ['central', 'ssc', 'upsc'].includes(p.category) || p.slug.includes('ssc') || p.slug.includes('upsc') || p.slug.includes('gds') || p.slug.includes('ctet') || p.slug.includes('rrb'));

const title = "Central Government Exam Photo & Signature Resizers — SSC, UPSC, Railway, GDS | UploadRight";
const description = "Free online photo and signature resizers for all Central Government recruitment exams. SSC CGL/CHSL, UPSC OTR, India Post GDS, CTET, and Railway RRB. 100% private.";
---

<BaseLayout title={title} description={description} canonicalSlug="central">
  <Header slot="header" />

  <div class="relative bg-white py-10 sm:py-16">
    <!-- Hero Header -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 mb-8 sm:mb-12 space-y-4">
      <nav class="flex items-center gap-2 text-xs text-[#86868B]" aria-label="Breadcrumb">
        <a href="/" class="hover:text-[#1D1D1F] transition-colors">Home</a>
        <span>/</span>
        <span class="text-[#1D1D1F] font-medium" aria-current="page">Central Govt Exams</span>
      </nav>

      <div class="space-y-3">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#F5F5F7] border border-[#E5E5EA] text-xs font-semibold text-[#1D1D1F]">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0062FF]"></span>
          <span>Central Govt Recruitment Hub</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold text-[#1D1D1F] tracking-tight leading-tight">
          Central Government <span class="text-[#0062FF]">Exam Resizers</span>
        </h1>
        <p class="text-sm sm:text-base text-[#86868B] max-w-2xl leading-relaxed">
          Official photo and signature criteria for Staff Selection Commission, Union Public Service Commission, Department of Posts, Railway Recruitment Board, and Central Board of Secondary Education.
        </p>
      </div>
    </section>

    <!-- Studio Workspace -->
    <section id="studio" class="mb-16">
      <ExamToolWorkspace initialMode="preset" />
    </section>

    <!-- Central Exams Grid -->
    <section class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">
      <div class="space-y-1">
        <h2 class="text-xl sm:text-2xl font-bold text-[#1D1D1F]">Supported Central Government Exams</h2>
        <p class="text-xs sm:text-sm text-[#86868B]">Select any exam for dedicated guidelines and specifications.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {centralPresets.map(p => (
          <a
            href={`/${p.slug}`}
            class="p-5 rounded-2xl border border-[#E5E5EA] bg-[#F5F5F7] hover:bg-[#EBF2FF] hover:border-[#0062FF]/40 transition-all group space-y-2"
          >
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-[#0062FF]">{p.exam}</span>
              <span class="text-[#86868B] group-hover:text-[#0062FF] transition-colors">→</span>
            </div>
            <h3 class="text-sm font-bold text-[#1D1D1F] group-hover:text-[#0062FF] transition-colors">{p.title}</h3>
            <p class="text-xs text-[#86868B] line-clamp-2">{p.description}</p>
          </a>
        ))}
      </div>
    </section>
  </div>

  <Footer slot="footer" />
</BaseLayout>
