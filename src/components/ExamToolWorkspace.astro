</div>

<script>
  import { processImage, loadImageFile, generateFilename, downloadBlob, sanitizeFilename } from '../utils/imageEngine';
  import Cropper from 'cropperjs';
  import 'cropperjs/dist/cropper.min.css';

  const root = document.getElementById('workspace')!;
  const allPresets = JSON.parse(root.dataset.allPresets || '[]');
  
  // Inspect URL parameters first
  const urlParams = new URLSearchParams(window.location.search);
  const paramExam = urlParams.get('exam');
  const paramDoc = urlParams.get('document');
  const paramDate = urlParams.get('date');

  let activeSlug = root.dataset.activeSlug || allPresets[0].slug;
  if (paramExam) {
    const matched = allPresets.find((p: any) => p.slug === paramExam || p.slug.startsWith(paramExam));
    if (matched) activeSlug = matched.slug;
  }

  let activePreset = allPresets.find((p: any) => p.slug === activeSlug) || allPresets[0];
  let slots = activePreset.slots;
  
  let activeSlotIndex = parseInt(root.dataset.initialSlotIndex || '0', 10);
  if (paramDoc) {
    const docIdx = slots.findIndex((s: any) => s.docType === paramDoc || s.id === paramDoc);
    if (docIdx !== -1) activeSlotIndex = docIdx;
  }
  if (activeSlotIndex >= slots.length) activeSlotIndex = 0;

  let initialModeProp = root.dataset.initialMode || 'preset';
  let topMode: 'resizer' | 'namedate' = (initialModeProp === 'placard' || paramDate === 'true') ? 'namedate' : 'resizer';
  let isCustomSizeActive = initialModeProp === 'custom';

  let cropper: Cropper | null = null;
  let currentRequestId = 0;
  const completedKit: Map<string, { blob: Blob; filename: string }> = new Map();

  // Top Tabs
  const topTabResizer = document.getElementById('top-tab-resizer');
  const topTabNamedate = document.getElementById('top-tab-namedate');
  const panelResizerMode = document.getElementById('panel-resizer-mode');
  const panelNamedateMode = document.getElementById('panel-namedate-mode');
  const step1Subtitle = document.getElementById('step1-subtitle');
  const uploadHeadline = document.getElementById('upload-headline');
  const btnApplyCropText = document.getElementById('btn-apply-crop-text');

  // Selected Exam Bar & Collapsible Picker
  const selectedExamBar = document.getElementById('selected-exam-bar');
  const selectedExamTitleText = document.getElementById('selected-exam-title-text');
  const btnChangeExam = document.getElementById('btn-change-exam');
  const btnChangeText = document.getElementById('btn-change-text');
  const examPickerCollapsible = document.getElementById('exam-picker-collapsible');
  const docTypeSection = document.getElementById('doc-type-section');
  const imageRequirementsCard = document.getElementById('image-requirements-card');
  const imageAdjustmentsCard = document.getElementById('image-adjustments-card');
  const panelCustomConfig = document.getElementById('panel-custom-config');
  const examFullGuideLink = document.getElementById('exam-full-guide-link') as HTMLAnchorElement | null;
  const btnToggleAllExams = document.getElementById('btn-toggle-all-exams');
  let isAllExamsExpanded = false;

  // Custom Controls
  const customWidthInput = document.getElementById('custom-width-input') as HTMLInputElement | null;
  const customHeightInput = document.getElementById('custom-height-input') as HTMLInputElement | null;
  const customMinKbInput = document.getElementById('custom-minkb-input') as HTMLInputElement | null;
  const customMaxKbInput = document.getElementById('custom-maxkb-input') as HTMLInputElement | null;
  const customDpiSelect = document.getElementById('custom-dpi-select') as HTMLSelectElement | null;
  const customLockRatio = document.getElementById('custom-lock-ratio') as HTMLInputElement | null;
  const customPadWhite = document.getElementById('custom-pad-white') as HTMLInputElement | null;
  const unitBtns = document.querySelectorAll('.unit-btn');
  const unitLabels = document.querySelectorAll('.unit-label');
  let currentUnit = 'px';

  // Dedicated Compressor Controls
  const compressorMinInput = document.getElementById('compressor-min-input') as HTMLInputElement | null;
  const compressorMaxInput = document.getElementById('compressor-max-input') as HTMLInputElement | null;
  const compressorDpiSelect = document.getElementById('compressor-dpi-select') as HTMLSelectElement | null;
  const compressorPresetBtns = document.querySelectorAll('.compressor-preset-btn');

  // Dedicated Signature Compressor Controls
  const sigcompressMinInput = document.getElementById('sigcompress-min-input') as HTMLInputElement | null;
  const sigcompressMaxInput = document.getElementById('sigcompress-max-input') as HTMLInputElement | null;
  const sigcompressEnableWhitener = document.getElementById('sigcompress-enable-whitener') as HTMLInputElement | null;
  const sigcompressStandardDims = document.getElementById('sigcompress-standard-dims') as HTMLInputElement | null;
  const sigKbPresetBtns = document.querySelectorAll('.sig-kb-preset-btn');

  // Name & Date Controls
  const namedateNameInput = document.getElementById('namedate-name-input') as HTMLInputElement | null;
  const namedateIncludeDate = document.getElementById('namedate-include-date') as HTMLInputElement | null;
  const namedateDateInput = document.getElementById('namedate-date-input') as HTMLInputElement | null;
  const namedateEnableResize = document.getElementById('namedate-enable-resize') as HTMLInputElement | null;
  const namedateResizeInputs = document.getElementById('namedate-resize-inputs');
  const namedateWidthInput = document.getElementById('namedate-width-input') as HTMLInputElement | null;
  const namedateHeightInput = document.getElementById('namedate-height-input') as HTMLInputElement | null;

  // Preset Search & Filter
  const examSearchInput = document.getElementById('exam-search-input') as HTMLInputElement | null;
  const catFilterBtns = document.querySelectorAll('.cat-filter-btn');
  const examCardBtns = document.querySelectorAll('.exam-card-btn');
  const docTypeGrid = document.getElementById('doc-type-grid');
  const activeSlotCounter = document.getElementById('active-slot-counter');
  const specDpi = document.getElementById('spec-dpi');
  const specDimensions = document.getElementById('spec-dimensions');
  const specFilesize = document.getElementById('spec-filesize');
  const specNotes = document.getElementById('spec-notes');

  // Adjustments Sliders
  const brightnessSlider = document.getElementById('brightness-slider') as HTMLInputElement;
  const brightnessValText = document.getElementById('brightness-val-text')!;
  const contrastSlider = document.getElementById('contrast-slider') as HTMLInputElement;
  const contrastValText = document.getElementById('contrast-val-text')!;
  const whitenerSlider = document.getElementById('whitener-slider') as HTMLInputElement;
  const whitenerValText = document.getElementById('whitener-val-text')!;
  const whitenerAdjustmentBox = document.getElementById('whitener-adjustment-box')!;

  // Stages & Containers
  const dropZone = document.getElementById('drop-zone')!;
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const uploadContainer = document.getElementById('upload-container')!;
  const imageEditorContainer = document.getElementById('image-editor-container')!;
  const cropperImage = document.getElementById('cropper-image') as HTMLImageElement;
  const cropperFileBar = document.getElementById('cropper-file-bar')!;
  const cropperFilenameDisplay = document.getElementById('cropper-filename-display')!;
  const cropperFileCloseBtn = document.getElementById('cropper-file-close-btn')!;
  const btnRotateLeft = document.getElementById('btn-rotate-left')!;
  const btnRotateRight = document.getElementById('btn-rotate-right')!;
  const btnResetCrop = document.getElementById('btn-reset-crop')!;
  const btnCancelCrop = document.getElementById('btn-cancel-crop')!;
  const cancelOpeningImage = document.getElementById('cancel-opening-image')!;
  const btnApplyCrop = document.getElementById('btn-apply-crop')!;
  const processingLoader = document.getElementById('processing-loader')!;
  const previewContainer = document.getElementById('preview-container')!;
  const resultFilenameDisplay = document.getElementById('result-filename-display');
  const originalImage = document.getElementById('original-image') as HTMLImageElement | null;
  const processedImage = document.getElementById('processed-image') as HTMLImageElement;
  const originalInfo = document.getElementById('original-info');
  const processedInfo = document.getElementById('processed-info')!;
  const resQualityTag = document.getElementById('res-quality-tag')!;
  const resAuditDims = document.getElementById('res-audit-dims')!;
  const resAuditKb = document.getElementById('res-audit-kb')!;
  const resAuditDpi = document.getElementById('res-audit-dpi')!;
  const downloadBtn = document.getElementById('download-btn')!;
  const downloadBtnText = document.getElementById('download-btn-text')!;
  const btnNextSlot = document.getElementById('btn-next-slot')!;
  const nextSlotName = document.getElementById('next-slot-name')!;
  const btnZipKit = document.getElementById('btn-zip-kit')!;
  const processAnotherBtn = document.getElementById('process-another-btn')!;

  // Camera & Samples
  const btnCamera = document.getElementById('btn-camera')!;
  const btnSample = document.getElementById('btn-sample')!;
  const btnSampleSig = document.getElementById('btn-sample-sig')!;
  const cameraModal = document.getElementById('camera-modal')!;
  const cameraVideo = document.getElementById('camera-video') as HTMLVideoElement;
  const btnCameraFlip = document.getElementById('btn-camera-flip')!;
  const btnCameraCapture = document.getElementById('btn-camera-capture')!;
  const btnCameraClose = document.getElementById('btn-camera-close')!;
  let cameraStream: MediaStream | null = null;
  let cameraFacing = 'user';

  let lastProcessedResult: { blob: Blob; filename: string } | null = null;
  let currentLoadedFile: File | null = null;

  function init() {
    setDefaultDate();
    initModeUI();
    setupEventListeners();
  }

  function setDefaultDate() {
    if (!namedateDateInput) return;
    const d = new Date();
    const dd = String(d.getDate()).padStart(2, '0');
    const mm = String(d.getMonth() + 1).padStart(2, '0');
    const yyyy = d.getFullYear();
    namedateDateInput.value = `${dd}-${mm}-${yyyy}`;
  }

  function setTopMode(mode: 'resizer' | 'namedate') {
    topMode = mode;
    if (mode === 'namedate') {
      if (topTabNamedate) topTabNamedate.className = 'top-mode-btn px-6 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer bg-white text-black shadow-xs';
      if (topTabResizer) topTabResizer.className = 'top-mode-btn px-6 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer text-neutral-600 hover:text-black';
      if (panelNamedateMode) panelNamedateMode.classList.remove('hidden');
      if (panelResizerMode) panelResizerMode.classList.add('hidden');
      if (step1Subtitle) step1Subtitle.textContent = 'Name & Date';
      if (uploadHeadline) uploadHeadline.textContent = 'Click or drop image to add Name & Date';
      if (btnApplyCropText) btnApplyCropText.textContent = 'Apply & Add Slate';
    } else {
      if (topTabResizer) topTabResizer.className = 'top-mode-btn px-6 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer bg-white text-black shadow-xs';
      if (topTabNamedate) topTabNamedate.className = 'top-mode-btn px-6 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer text-neutral-600 hover:text-black';
      if (panelResizerMode) panelResizerMode.classList.remove('hidden');
      if (panelNamedateMode) panelNamedateMode.classList.add('hidden');
      if (step1Subtitle) step1Subtitle.textContent = 'Exam & Doc Type';
      if (uploadHeadline) uploadHeadline.textContent = 'Drop photo or signature here';
      if (btnApplyCropText) btnApplyCropText.textContent = 'Apply & Optimize';
    }
  }

  function initModeUI() {
    if (topMode === 'namedate') {
      setTopMode('namedate');
      return;
    }

    if (initialModeProp === 'compressor') {
      if (step1Subtitle) step1Subtitle.textContent = 'Target File Size';
      if (uploadHeadline) uploadHeadline.textContent = 'Drop image here to compress to exact KB';
      if (btnApplyCropText) btnApplyCropText.textContent = 'Apply & Compress';
      return;
    }

    if (initialModeProp === 'signature-compressor') {
      if (step1Subtitle) step1Subtitle.textContent = 'Signature Settings';
      if (uploadHeadline) uploadHeadline.textContent = 'Drop signature photo to whiten & compress';
      if (btnApplyCropText) btnApplyCropText.textContent = 'Apply & Compress';
      if (whitenerAdjustmentBox) whitenerAdjustmentBox.classList.remove('hidden');
      return;
    }

    if (initialModeProp === 'signature-resizer' || initialModeProp === 'whitener') {
      if (step1Subtitle) step1Subtitle.textContent = 'Signature Dimensions';
      if (uploadHeadline) uploadHeadline.textContent = 'Drop signature here to resize';
      if (btnApplyCropText) btnApplyCropText.textContent = 'Apply & Resize';
      if (whitenerAdjustmentBox) whitenerAdjustmentBox.classList.remove('hidden');
      updateCustomSpecs();
      return;
    }

    if (initialModeProp === 'photo-resizer') {
      if (step1Subtitle) step1Subtitle.textContent = 'Photo Dimensions';
      if (uploadHeadline) uploadHeadline.textContent = 'Drop passport photo here to resize';
      if (btnApplyCropText) btnApplyCropText.textContent = 'Apply & Resize';
      updateCustomSpecs();
      return;
    }

    if (initialModeProp === 'image-resizer') {
      if (step1Subtitle) step1Subtitle.textContent = 'Image Dimensions';
      if (uploadHeadline) uploadHeadline.textContent = 'Drop image here to resize';
      if (btnApplyCropText) btnApplyCropText.textContent = 'Apply & Resize';
      updateCustomSpecs();
      return;
    }

    if (initialModeProp === 'custom') {
      if (step1Subtitle) step1Subtitle.textContent = 'Custom Dimensions';
      if (uploadHeadline) uploadHeadline.textContent = 'Drop image here to resize';
      if (btnApplyCropText) btnApplyCropText.textContent = 'Apply & Resize';
      updateCustomSpecs();
      return;
    }

    // Default: Exam Preset mode
    setTopMode('resizer');
    renderSlotPills();
    updateSpecsView();
  }

  function updateSpecsView() {
    if (isCustomSizeActive) {
      updateCustomSpecs();
      return;
    }
    const slot = slots[activeSlotIndex] || slots[0];
    if (specDimensions) specDimensions.textContent = `${slot.widthPx}×${slot.heightPx} px`;
    if (specFilesize) specFilesize.textContent = `${slot.minKB}–${slot.maxKB} KB`;
    if (specDpi) specDpi.textContent = `JPG · ${slot.dpi} DPI`;
    if (specNotes) specNotes.textContent = slot.notes || slot.background || 'Ensure clear passport composition with neutral background.';

    const isSignature = ['signature', 'thumb', 'declaration'].includes(slot.docType);
    if (whitenerAdjustmentBox) whitenerAdjustmentBox.classList.toggle('hidden', !isSignature);

    if (cropper) {
      cropper.setAspectRatio(slot.widthPx / slot.heightPx);
    }
  }

  function updateCustomSpecs() {
    const w = parseInt(customWidthInput?.value || '350', 10);
    const h = parseInt(customHeightInput?.value || '450', 10);
    const minKb = parseInt(customMinKbInput?.value || '20', 10);
    const maxKb = parseInt(customMaxKbInput?.value || '50', 10);
    const dpi = parseInt(customDpiSelect?.value || '200', 10);

    if (specDimensions) specDimensions.textContent = `${w}×${h} px`;
    if (specFilesize) specFilesize.textContent = `${minKb}–${maxKb} KB`;
    if (specDpi) specDpi.textContent = `JPG · ${dpi} DPI`;

    if (cropper && customLockRatio && customLockRatio.checked) {
      cropper.setAspectRatio(w / h);
    }
  }

  function setupEventListeners() {
    // Top Mode Switcher
    if (topTabResizer) {
      topTabResizer.addEventListener('click', () => {
        setTopMode('resizer');
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.delete('date');
        window.history.replaceState({}, '', newUrl.toString());
      });
    }

    if (topTabNamedate) {
      topTabNamedate.addEventListener('click', () => {
        setTopMode('namedate');
        const newUrl = new URL(window.location.href);
        newUrl.searchParams.set('date', 'true');
        window.history.replaceState({}, '', newUrl.toString());
      });
    }

    // Change Exam Collapsible Toggle
    if (btnChangeExam && examPickerCollapsible && btnChangeText) {
      btnChangeExam.addEventListener('click', () => {
        const isHidden = examPickerCollapsible.classList.contains('hidden');
        examPickerCollapsible.classList.toggle('hidden', !isHidden);
        btnChangeText.textContent = isHidden ? 'Close' : 'Change';
      });
    }

    // Compressor Presets
    compressorPresetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const min = (btn as HTMLElement).dataset.min || '20';
        const max = (btn as HTMLElement).dataset.max || '50';
        if (compressorMinInput) compressorMinInput.value = min;
        if (compressorMaxInput) compressorMaxInput.value = max;
        compressorPresetBtns.forEach(b => {
          b.className = 'compressor-preset-btn px-2.5 py-2 rounded-xl text-xs font-bold font-mono border-2 border-[#e6e6e6] hover:border-black transition cursor-pointer';
        });
        btn.className = 'compressor-preset-btn px-2.5 py-2 rounded-xl text-xs font-bold font-mono border-2 border-black bg-black text-white transition cursor-pointer';
      });
    });

    // Signature Compressor Presets
    sigKbPresetBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const min = (btn as HTMLElement).dataset.min || '10';
        const max = (btn as HTMLElement).dataset.max || '20';
        if (sigcompressMinInput) sigcompressMinInput.value = min;
        if (sigcompressMaxInput) sigcompressMaxInput.value = max;
        sigKbPresetBtns.forEach(b => {
          b.className = 'sig-kb-preset-btn px-2 py-2 rounded-xl text-xs font-bold font-mono border-2 border-[#e6e6e6] hover:border-black transition cursor-pointer';
        });
        btn.className = 'sig-kb-preset-btn px-2 py-2 rounded-xl text-xs font-bold font-mono border-2 border-black bg-black text-white transition cursor-pointer';
      });
    });

    // Name & Date Options
    if (namedateIncludeDate && namedateDateInput) {
      namedateIncludeDate.addEventListener('change', () => {
        namedateDateInput.disabled = !namedateIncludeDate.checked;
        namedateDateInput.classList.toggle('opacity-50', !namedateIncludeDate.checked);
      });
    }

    if (namedateEnableResize && namedateResizeInputs) {
      namedateEnableResize.addEventListener('change', () => {
        const enabled = namedateEnableResize.checked;
        namedateResizeInputs.classList.toggle('opacity-50', !enabled);
        namedateResizeInputs.classList.toggle('pointer-events-none', !enabled);
        if (cropper) {
          if (enabled) {
            const w = parseInt(namedateWidthInput?.value || '350', 10);
            const h = parseInt(namedateHeightInput?.value || '450', 10);
            cropper.setAspectRatio(w / h);
          } else {
            cropper.setAspectRatio(NaN);
          }
        }
      });
    }

    [namedateWidthInput, namedateHeightInput].filter(Boolean).forEach(inp => {
      inp!.addEventListener('input', () => {
        if (cropper && namedateEnableResize && namedateEnableResize.checked) {
          const w = parseInt(namedateWidthInput?.value || '350', 10);
          const h = parseInt(namedateHeightInput?.value || '450', 10);
          cropper.setAspectRatio(w / h);
        }
      });
    });

    // Toggle All Exams straight expansion (Zero Scroll)
    if (btnToggleAllExams) {
      btnToggleAllExams.addEventListener('click', () => {
        isAllExamsExpanded = !isAllExamsExpanded;
        document.querySelectorAll('.hidden-exam').forEach(el => {
          el.classList.toggle('hidden', !isAllExamsExpanded);
        });
        btnToggleAllExams.textContent = isAllExamsExpanded
          ? '− Show Fewer Presets'
          : `+ View All Exams (${allPresets.length} Presets)`;
      });
    }

    // Custom Mode Card Click
    const btnExamCustomCard = document.getElementById('btn-exam-custom-card');
    if (btnExamCustomCard && selectedExamTitleText && panelCustomConfig) {
      btnExamCustomCard.addEventListener('click', () => {
        isCustomSizeActive = true;
        selectedExamTitleText.textContent = 'Custom Size';
        panelCustomConfig.classList.remove('hidden');
        if (imageRequirementsCard) imageRequirementsCard.classList.add('hidden');
        if (docTypeSection) docTypeSection.classList.add('hidden');
        if (examPickerCollapsible) examPickerCollapsible.classList.add('hidden');
        if (btnChangeText) btnChangeText.textContent = 'Change';
        updateCustomSpecs();
      });
    }

    // Custom Inputs
    [customWidthInput, customHeightInput, customMinKbInput, customMaxKbInput, customDpiSelect].filter(Boolean).forEach(el => {
      el!.addEventListener('input', () => {
        updateCustomSpecs();
        if (cropper && customLockRatio && customLockRatio.checked) {
          const w = parseInt(customWidthInput?.value || '350', 10);
          const h = parseInt(customHeightInput?.value || '450', 10);
          cropper.setAspectRatio(w / h);
        }
      });
    });

    if (customLockRatio) {
      customLockRatio.addEventListener('change', () => {
        if (!cropper) return;
        if (customLockRatio.checked) {
          const w = parseInt(customWidthInput?.value || '350', 10);
          const h = parseInt(customHeightInput?.value || '450', 10);
          cropper.setAspectRatio(w / h);
        } else {
          cropper.setAspectRatio(NaN);
        }
      });
    }

    // Sliders
    brightnessSlider.addEventListener('input', () => {
      brightnessValText.textContent = brightnessSlider.value;
    });

    contrastSlider.addEventListener('input', () => {
      contrastValText.textContent = contrastSlider.value;
    });

    whitenerSlider.addEventListener('input', () => {
      whitenerValText.textContent = whitenerSlider.value;
    });

    // Units
    unitBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const newUnit = (btn as HTMLElement).dataset.unit || 'px';
        if (newUnit === currentUnit) return;
        convertCustomUnits(currentUnit, newUnit);
        currentUnit = newUnit;
        unitBtns.forEach(b => {
          if ((b as HTMLElement).dataset.unit === newUnit) {
            b.classList.add('bg-black', 'text-white');
            b.classList.remove('bg-[#f7f7f5]', 'text-black');
          } else {
            b.classList.remove('bg-black', 'text-white');
            b.classList.add('bg-[#f7f7f5]', 'text-black');
          }
        });
        unitLabels.forEach(l => l.textContent = newUnit);
      });
    });

    // Exam Search
    examSearchInput.addEventListener('input', () => {
      const q = examSearchInput.value.trim().toLowerCase();
      examCardBtns.forEach(btn => {
        const searchMeta = (btn as HTMLElement).dataset.search || '';
        const match = q === '' ? true : searchMeta.includes(q);
        const idx = parseInt((btn as HTMLElement).dataset.index || '0', 10);
        if (q === '') {
          btn.classList.toggle('hidden', idx >= 8 && !isAllExamsExpanded);
        } else {
          btn.classList.toggle('hidden', !match);
        }
      });
      if (btnToggleAllExams) {
        btnToggleAllExams.classList.toggle('hidden', q !== '');
      }
    });

    // Category Filter Chips
    catFilterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catFilterBtns.forEach(b => {
          b.classList.remove('bg-black', 'text-white', 'font-bold');
          b.classList.add('bg-[#f7f7f5]', 'text-black', 'font-medium', 'border', 'border-[#e6e6e6]');
        });
        btn.classList.add('bg-black', 'text-white', 'font-bold');
        btn.classList.remove('bg-[#f7f7f5]', 'text-black', 'font-medium');

        const cat = (btn as HTMLElement).dataset.cat || 'all';
        examCardBtns.forEach(card => {
          const cardCat = (card as HTMLElement).dataset.cat || '';
          const idx = parseInt((card as HTMLElement).dataset.index || '0', 10);
          if (cat === 'all') {
            card.classList.toggle('hidden', idx >= 8 && !isAllExamsExpanded);
          } else {
            card.classList.toggle('hidden', cardCat !== cat);
          }
        });
        if (btnToggleAllExams) {
          btnToggleAllExams.classList.toggle('hidden', cat !== 'all');
        }
      });
    });

    // Exam Card selection - natural link redirection to each exam's dedicated page

    // Dropzone
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        fileInput.click();
      }
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files?.length) {
        loadFile(fileInput.files[0]);
      }
    });

    dropZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      dropZone.classList.add('border-black', 'bg-[#f7f7f5]');
    });

    dropZone.addEventListener('dragleave', () => {
      dropZone.classList.remove('border-black', 'bg-[#f7f7f5]');
    });

    dropZone.addEventListener('drop', (e) => {
      e.preventDefault();
      dropZone.classList.remove('border-black', 'bg-[#f7f7f5]');
      if (e.dataTransfer?.files.length) {
        loadFile(e.dataTransfer.files[0]);
      }
    });

    btnCancelCrop.addEventListener('click', resetUploader);
    cancelOpeningImage.addEventListener('click', resetUploader);
    cropperFileCloseBtn.addEventListener('click', resetUploader);
    processAnotherBtn.addEventListener('click', resetUploader);

    // 75% Biometric Face Guide Toggle
    const btnToggleFaceGuide = document.getElementById('btn-toggle-face-guide');
    const faceGuideOverlay = document.getElementById('face-guide-overlay');
    const faceGuideToggleText = document.getElementById('face-guide-toggle-text');
    let isFaceGuideActive = root.dataset.showFaceGuide === 'true';

    if (btnToggleFaceGuide && faceGuideOverlay) {
      btnToggleFaceGuide.addEventListener('click', () => {
        isFaceGuideActive = !isFaceGuideActive;
        if (isFaceGuideActive) {
          faceGuideOverlay.classList.remove('hidden');
          btnToggleFaceGuide.className = 'px-3 py-1.5 rounded-full border text-xs font-semibold font-mono transition-colors flex items-center gap-1.5 cursor-pointer bg-black text-white border-black';
          if (faceGuideToggleText) faceGuideToggleText.textContent = 'Face Guide: ON';
        } else {
          faceGuideOverlay.classList.add('hidden');
          btnToggleFaceGuide.className = 'px-3 py-1.5 rounded-full border text-xs font-semibold font-mono transition-colors flex items-center gap-1.5 cursor-pointer bg-white hover:bg-black hover:text-white border-[#e6e6e6] text-black';
          if (faceGuideToggleText) faceGuideToggleText.textContent = '75% Face Guide';
        }
      });
    }

    // Rotation & Reset
    btnRotateLeft.addEventListener('click', () => {
      if (cropper) cropper.rotate(-90);
    });
    btnRotateRight.addEventListener('click', () => {
      if (cropper) cropper.rotate(90);
    });
    btnResetCrop.addEventListener('click', () => {
      if (cropper) cropper.reset();
    });

    // Apply & Optimize
    document.querySelectorAll('.btn-apply-crop-action').forEach(btn => {
      btn.addEventListener('click', () => {
        handleProcess();
      });
    });

    // Download Button
    downloadBtn.addEventListener('click', () => {
      if (lastProcessedResult) {
        downloadBlob(lastProcessedResult.blob, lastProcessedResult.filename);
      }
    });

    btnZipKit.addEventListener('click', handleZipKit);
    btnNextSlot.addEventListener('click', handleNextSlot);

    // Demo Samples
    btnSample.addEventListener('click', () => handleSampleDemo(false));
    btnSampleSig.addEventListener('click', () => handleSampleDemo(true));

    // Camera
    btnCamera.addEventListener('click', openCamera);
    btnCameraCapture.addEventListener('click', captureCamera);
    btnCameraClose.addEventListener('click', closeCamera);
    btnCameraFlip.addEventListener('click', flipCamera);
  }

  function convertCustomUnits(fromUnit: string, toUnit: string) {
    const dpi = parseInt(customDpiSelect.value, 10) || 200;
    let w = parseFloat(customWidthInput.value) || 350;
    let h = parseFloat(customHeightInput.value) || 450;

    let pxW = w;
    let pxH = h;
    if (fromUnit === 'cm') {
      pxW = (w / 2.54) * dpi;
      pxH = (h / 2.54) * dpi;
    } else if (fromUnit === 'mm') {
      pxW = (w / 25.4) * dpi;
      pxH = (h / 25.4) * dpi;
    } else if (fromUnit === 'inch') {
      pxW = w * dpi;
      pxH = h * dpi;
    }

    if (toUnit === 'px') {
      customWidthInput.value = String(Math.round(pxW));
      customHeightInput.value = String(Math.round(pxH));
    } else if (toUnit === 'cm') {
      customWidthInput.value = ((pxW / dpi) * 2.54).toFixed(1);
      customHeightInput.value = ((pxH / dpi) * 2.54).toFixed(1);
    } else if (toUnit === 'mm') {
      customWidthInput.value = ((pxW / dpi) * 25.4).toFixed(0);
      customHeightInput.value = ((pxH / dpi) * 25.4).toFixed(0);
    } else if (toUnit === 'inch') {
      customWidthInput.value = (pxW / dpi).toFixed(2);
      customHeightInput.value = (pxH / dpi).toFixed(2);
    }
  }

  function selectExam(slug: string) {
    const found = allPresets.find((p: any) => p.slug === slug);
    if (!found) return;
    activeSlug = slug;
    activePreset = found;
    slots = found.slots;
    activeSlotIndex = 0;
    isCustomSizeActive = false;

    selectedExamTitleText.textContent = found.shortTitle || found.exam;
    if (examFullGuideLink) examFullGuideLink.href = `/${found.slug}`;

    panelCustomConfig.classList.add('hidden');
    imageRequirementsCard.classList.remove('hidden');
    docTypeSection.classList.remove('hidden');
    examPickerCollapsible.classList.add('hidden');
    btnChangeText.textContent = 'Change';

    examCardBtns.forEach(btn => {
      const bSlug = (btn as HTMLElement).dataset.slug;
      if (bSlug === slug) {
        btn.className = 'exam-card-btn p-2.5 rounded-xl text-left border-2 transition-all cursor-pointer group flex flex-col justify-between bg-black text-white border-black font-semibold shadow-xs';
      } else {
        btn.className = 'exam-card-btn p-2.5 rounded-xl text-left border-2 transition-all cursor-pointer group flex flex-col justify-between bg-white text-black border-[#e6e6e6] hover:border-black hover:bg-[#f7f7f5]';
      }
    });

    renderSlotPills();
    updateSpecsView();

    // Update URL query state without full reload
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.set('exam', slug);
    window.history.replaceState({}, '', newUrl.toString());
  }

  function renderSlotPills() {
    docTypeGrid.innerHTML = '';
    activeSlotCounter.textContent = `${activeSlotIndex + 1} of ${slots.length}`;

    slots.forEach((s: any, idx: number) => {
      const btn = document.createElement('button');
      btn.type = 'button';
      const isSelected = idx === activeSlotIndex;

      btn.className = `p-3 rounded-2xl border-2 text-left transition-all cursor-pointer flex flex-col justify-between ${
        isSelected
          ? 'bg-black text-white border-black shadow-md'
          : 'bg-white text-black border-[#e6e6e6] hover:border-black hover:bg-[#f7f7f5]'
      }`;

      const icon = s.docType === 'photo' ? '📷' : s.docType === 'signature' ? '✍️' : s.docType === 'thumb' ? '👆' : '📄';
      const subtitle = s.docType === 'photo' ? 'Passport' : s.docType === 'signature' ? 'Sign' : s.docType === 'thumb' ? 'Thumb' : 'Doc';

      btn.innerHTML = `
        <div class="flex items-center justify-between">
          <span class="text-base">${icon}</span>
          ${completedKit.has(s.id) ? '<span class="w-2 h-2 rounded-full bg-[#1ea64a]"></span>' : ''}
        </div>
        <div class="mt-2">
          <span class="text-xs font-bold block truncate">${s.label}</span>
          <span class="text-[10px] block font-mono ${isSelected ? 'text-neutral-300' : 'text-neutral-500'}">${s.widthPx}×${s.heightPx}</span>
        </div>
      `;

      btn.addEventListener('click', () => {
        activeSlotIndex = idx;
        renderSlotPills();
        updateSpecsView();
      });

      docTypeGrid.appendChild(btn);
    });
  }

  async function loadFile(file: File) {
    currentLoadedFile = file;
    try {
      const img = await loadImageFile(file);
      if (originalImage) originalImage.src = img.src;
      if (originalInfo) originalInfo.textContent = `${img.naturalWidth}×${img.naturalHeight} px · ${(file.size / 1024).toFixed(1)} KB`;

      cropperFilenameDisplay.textContent = `${file.name} (${(file.size / 1024).toFixed(1)} KB)`;

      uploadContainer.classList.add('hidden');
      imageEditorContainer.classList.remove('hidden');
      cancelOpeningImage.classList.remove('hidden');
      previewContainer.classList.add('hidden');

      if (cropper) {
        cropper.destroy();
        cropper = null;
      }

      let targetRatio = NaN;
      if (topMode === 'namedate') {
        if (namedateEnableResize && namedateEnableResize.checked) {
          const w = parseInt(namedateWidthInput?.value || '350', 10);
          const h = parseInt(namedateHeightInput?.value || '450', 10);
          targetRatio = w / h;
        } else {
          targetRatio = NaN;
        }
      } else if (initialModeProp === 'compressor') {
        targetRatio = NaN; // free aspect ratio
      } else if (initialModeProp === 'signature-compressor') {
        const useStd = sigcompressStandardDims ? sigcompressStandardDims.checked : true;
        targetRatio = useStd ? (140 / 60) : NaN;
      } else if (initialModeProp === 'photo-resizer') {
        targetRatio = 350 / 450;
      } else if (['signature-resizer', 'whitener'].includes(initialModeProp)) {
        targetRatio = 140 / 60;
      } else if (isCustomSizeActive || ['custom', 'image-resizer'].includes(initialModeProp)) {
        const w = parseInt(customWidthInput?.value || '350', 10);
        const h = parseInt(customHeightInput?.value || '450', 10);
        if (customLockRatio && customLockRatio.checked) targetRatio = w / h;
      } else {
        const slot = slots[activeSlotIndex] || slots[0];
        targetRatio = slot ? (slot.widthPx / slot.heightPx) : NaN;
      }

      cropperImage.src = img.src;
      const initCropper = () => {
        if (cropper) cropper.destroy();
        cropper = new Cropper(cropperImage, {
          aspectRatio: targetRatio,
          viewMode: 1,
          dragMode: 'move',
          autoCropArea: 0.92,
          responsive: true,
          restore: false,
          guides: true,
          center: true,
          highlight: false,
          cropBoxMovable: true,
          cropBoxResizable: true,
          toggleDragModeOnDblclick: false,
        });
      };

      if (cropperImage.complete) {
        initCropper();
      } else {
        cropperImage.onload = () => initCropper();
      }

    } catch (err: any) {
      alert(`Could not open image: ${err.message || 'Please check file format.'}`);
    }
  }

  function resetUploader() {
    uploadContainer.classList.remove('hidden');
    imageEditorContainer.classList.add('hidden');
    cancelOpeningImage.classList.add('hidden');
    processingLoader.classList.add('hidden');
    previewContainer.classList.add('hidden');
    if (cropper) {
      cropper.destroy();
      cropper = null;
    }
    fileInput.value = '';
    currentLoadedFile = null;
  }

  async function handleProcess() {
    if (!cropper) return;
    const requestId = ++currentRequestId;

    imageEditorContainer.classList.add('hidden');
    processingLoader.classList.remove('hidden');

    try {
      const croppedCanvas = cropper.getCroppedCanvas();
      if (!croppedCanvas) throw new Error('Could not extract crop canvas');

      let targetWidth = 350;
      let targetHeight = 450;
      let minKB = 20;
      let maxKB = 50;
      let dpi = 200;
      let padWhite = false;
      let slotId = 'document';
      let docType = 'photo';
      let placardName: string | undefined = undefined;
      let placardDate: string | undefined = undefined;

      const brightnessVal = parseInt(brightnessSlider.value, 10) || 0;
      const contrastVal = parseInt(contrastSlider.value, 10) || 0;
      const whitenerThresholdVal = parseInt(whitenerSlider.value, 10) || 220;

      if (topMode === 'namedate') {
        const nameVal = namedateNameInput?.value.trim() || '';
        const dateVal = (namedateIncludeDate && namedateIncludeDate.checked) ? (namedateDateInput?.value.trim() || '') : '';
        placardName = nameVal || undefined;
        placardDate = dateVal || undefined;

        if (namedateEnableResize && namedateEnableResize.checked) {
          targetWidth = parseInt(namedateWidthInput?.value || '350', 10);
          targetHeight = parseInt(namedateHeightInput?.value || '450', 10);
        } else {
          targetWidth = croppedCanvas.width;
          targetHeight = croppedCanvas.height;
        }
        minKB = 20;
        maxKB = 100;
        dpi = 200;
        slotId = 'photo_namedate';
      } else if (initialModeProp === 'compressor') {
        targetWidth = croppedCanvas.width;
        targetHeight = croppedCanvas.height;
        minKB = parseInt(compressorMinInput?.value || '20', 10);
        maxKB = parseInt(compressorMaxInput?.value || '50', 10);
        dpi = parseInt(compressorDpiSelect?.value || '200', 10);
        slotId = 'image';
        docType = 'photo';
      } else if (initialModeProp === 'signature-compressor') {
        const useStd = sigcompressStandardDims ? sigcompressStandardDims.checked : true;
        if (useStd) {
          targetWidth = 140;
          targetHeight = 60;
        } else {
          targetWidth = croppedCanvas.width;
          targetHeight = croppedCanvas.height;
        }
        minKB = parseInt(sigcompressMinInput?.value || '10', 10);
        maxKB = parseInt(sigcompressMaxInput?.value || '20', 10);
        dpi = 200;
        slotId = 'signature';
        docType = 'signature';
      } else if (isCustomSizeActive || ['custom', 'photo-resizer', 'image-resizer', 'signature-resizer', 'whitener'].includes(initialModeProp)) {
        targetWidth = parseInt(customWidthInput?.value || '350', 10);
        targetHeight = parseInt(customHeightInput?.value || '450', 10);
        minKB = parseInt(customMinKbInput?.value || '20', 10);
        maxKB = parseInt(customMaxKbInput?.value || '50', 10);
        dpi = parseInt(customDpiSelect?.value || '200', 10);
        padWhite = customPadWhite ? customPadWhite.checked : false;
        slotId = 'custom';
        if (['signature-resizer', 'whitener'].includes(initialModeProp)) {
          docType = 'signature';
        }
      } else {
        const slot = slots[activeSlotIndex] || slots[0];
        targetWidth = slot.widthPx;
        targetHeight = slot.heightPx;
        minKB = slot.minKB;
        maxKB = slot.maxKB;
        dpi = slot.dpi;
        padWhite = false;
        slotId = slot.id;
        docType = slot.docType;
      }

      const isSignature = ['signature', 'thumb', 'declaration'].includes(docType) ||
        (initialModeProp === 'signature-compressor' && (sigcompressEnableWhitener ? sigcompressEnableWhitener.checked : true)) ||
        initialModeProp === 'signature-resizer' ||
        initialModeProp === 'whitener';

      const options = {
        targetWidth,
        targetHeight,
        minKB,
        maxKB,
        dpi,
        padWhiteBorders: padWhite,
        applyWhitener: isSignature,
        whitenerThreshold: whitenerThresholdVal,
        brightness: brightnessVal,
        contrast: contrastVal,
        placardName,
        placardDate,
      };

      const result = await processImage(croppedCanvas, options);
      if (requestId !== currentRequestId) return;

      const outputUrl = URL.createObjectURL(result.blob);
      processedImage.src = outputUrl;

      const actualKB = result.sizeKB.toFixed(1);
      processedInfo.textContent = `${result.width}×${result.height} px · ${actualKB} KB (${result.dpi} DPI)`;

      // Audit Checklist update
      resQualityTag.textContent = `Q: ${Math.round(result.qualityUsed * 100)}%`;
      resAuditDims.textContent = `${result.width}×${result.height} px`;
      resAuditKb.textContent = `${actualKB} KB`;
      resAuditDpi.textContent = `${result.dpi} DPI`;

      let prefix = activePreset.slug;
      if (topMode === 'namedate') prefix = 'photo-namedate';
      else if (initialModeProp === 'compressor') prefix = 'compressed';
      else if (initialModeProp === 'signature-compressor') prefix = 'signature-compressed';
      else if (initialModeProp === 'photo-resizer') prefix = 'passport-photo';
      else if (initialModeProp === 'signature-resizer') prefix = 'signature-resized';
      else if (initialModeProp === 'whitener') prefix = 'signature-whitened';
      else if (initialModeProp === 'image-resizer') prefix = 'image-resized';
      else if (isCustomSizeActive || initialModeProp === 'custom') prefix = 'custom-resized';

      const safeFilename = generateFilename(
        prefix,
        slotId,
        result.blob.size
      );
      lastProcessedResult = { blob: result.blob, filename: safeFilename };
      downloadBtnText.textContent = `Download ${safeFilename} (${actualKB} KB)`;
      if (resultFilenameDisplay) {
        resultFilenameDisplay.textContent = `${safeFilename} (${actualKB} KB)`;
      }

      if (topMode !== 'namedate' && !isCustomSizeActive && initialModeProp === 'preset') {
        completedKit.set(slotId, { blob: result.blob, filename: safeFilename });
        renderSlotPills();

        if (activeSlotIndex < slots.length - 1) {
          const nextSlot = slots[activeSlotIndex + 1];
          nextSlotName.textContent = nextSlot.label;
          btnNextSlot.classList.remove('hidden');
        } else {
          btnNextSlot.classList.add('hidden');
        }
      }

      processingLoader.classList.add('hidden');
      previewContainer.classList.remove('hidden');

    } catch (err: any) {
      processingLoader.classList.add('hidden');
      imageEditorContainer.classList.remove('hidden');
      alert(`Processing error: ${err.message || 'Could not satisfy file size constraints.'}`);
    }
  }

  function handleNextSlot() {
    if (activeSlotIndex < slots.length - 1) {
      activeSlotIndex++;
      renderSlotPills();
      updateSpecsView();
      resetUploader();
    }
  }

  async function handleZipKit() {
    if (completedKit.size === 0) {
      alert('Please process at least one document before downloading the full kit.');
      return;
    }
    const JSZip = (await import('jszip')).default;
    const zip = new JSZip();

    completedKit.forEach(({ blob, filename }) => {
      zip.file(filename, blob);
    });

    const zipBlob = await zip.generateAsync({ type: 'blob' });
    downloadBlob(zipBlob, `${sanitizeFilename(activePreset.slug)}_complete_kit.zip`);
  }

  // Live Camera
  async function openCamera() {
    try {
      cameraStream = await navigator.mediaDevices.getUserMedia({
        video: { facingMode: cameraFacing, width: { ideal: 1280 }, height: { ideal: 720 } }
      });
      cameraVideo.srcObject = cameraStream;
      cameraModal.classList.remove('hidden');
    } catch (err: any) {
      alert(`Camera access denied or unavailable: ${err.message}`);
    }
  }

  function closeCamera() {
    if (cameraStream) {
      cameraStream.getTracks().forEach(t => t.stop());
      cameraStream = null;
    }
    cameraModal.classList.add('hidden');
  }

  function flipCamera() {
    cameraFacing = cameraFacing === 'user' ? 'environment' : 'user';
    closeCamera();
    openCamera();
  }

  function captureCamera() {
    if (!cameraVideo.videoWidth) return;
    const canvas = document.createElement('canvas');
    canvas.width = cameraVideo.videoWidth;
    canvas.height = cameraVideo.videoHeight;
    const ctx = canvas.getContext('2d')!;
    ctx.drawImage(cameraVideo, 0, 0);
    closeCamera();

    canvas.toBlob((blob) => {
      if (blob) {
        const file = new File([blob], 'camera_capture.jpg', { type: 'image/jpeg' });
        loadFile(file);
      }
    }, 'image/jpeg', 0.95);
  }

  function handleSampleDemo(isSignature: boolean) {
    const canvas = document.createElement('canvas');
    canvas.width = 600;
    canvas.height = 700;
    const ctx = canvas.getContext('2d')!;

    if (!isSignature) {
      ctx.fillStyle = '#FFFFFF';
      ctx.fillRect(0, 0, 600, 700);

      ctx.fillStyle = '#1e293b';
      ctx.beginPath();
      ctx.ellipse(300, 640, 240, 160, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath();
      ctx.moveTo(270, 480);
      ctx.lineTo(300, 540);
      ctx.lineTo(330, 480);
      ctx.closePath();
      ctx.fill();

      ctx.fillStyle = '#E5B895';
      ctx.fillRect(265, 380, 70, 110);

      ctx.beginPath();
      ctx.ellipse(300, 280, 115, 145, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#0f172a';
      ctx.beginPath();
      ctx.arc(300, 200, 125, Math.PI * 0.9, Math.PI * 2.1);
      ctx.fill();

      ctx.fillStyle = '#FFFFFF';
      ctx.beginPath();
      ctx.ellipse(255, 270, 18, 12, 0, 0, Math.PI * 2);
      ctx.ellipse(345, 270, 18, 12, 0, 0, Math.PI * 2);
      ctx.fill();

      ctx.fillStyle = '#1e293b';
      ctx.beginPath();
      ctx.arc(255, 270, 8, 0, Math.PI * 2);
      ctx.arc(345, 270, 8, 0, Math.PI * 2);
      ctx.fill();

      ctx.strokeStyle = '#975A16';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(300, 320, 14, 0, Math.PI);
      ctx.stroke();
    } else {
      ctx.fillStyle = '#FAF9F6';
      ctx.fillRect(0, 0, 600, 700);

      ctx.strokeStyle = '#0F172A';
      ctx.lineWidth = 6;
      ctx.lineCap = 'round';
      ctx.lineJoin = 'round';
      ctx.beginPath();
      ctx.moveTo(120, 360);
      ctx.bezierCurveTo(160, 240, 220, 230, 260, 350);
      ctx.bezierCurveTo(280, 420, 320, 300, 380, 340);
      ctx.bezierCurveTo(420, 360, 460, 310, 490, 350);
      ctx.moveTo(180, 370);
      ctx.lineTo(440, 370);
      ctx.stroke();
    }

    canvas.toBlob((blob) => {
      if (blob) {
        const file = new File([blob], isSignature ? 'sample_signature.jpg' : 'sample_candidate_photo.jpg', { type: 'image/jpeg' });
        loadFile(file);
      }
    }, 'image/jpeg', 0.95);
  }

  // Initialize
  init();
</script>
