---
// UploadRight — Official Figma Design System Exam Studio & Universal Engine
// Design System: Monochrome editorial canvas (#000000 / #ffffff), 2px hairline borders (#e6e6e6),
// tactile pill CTAs (rounded-full), pastel accents (#dceeb1, #c5b0f4, #c8e6cd), 100% client-side privacy.
import presets from '../data/presets.json';

interface Props {
  activePresetSlug?: string;
  initialSlotIndex?: number;
  initialMode?:
    | 'preset'
    | 'custom'
    | 'placard'
    | 'whitener'
    | 'compressor'
    | 'signature-compressor'
    | 'photo-resizer'
    | 'image-resizer'
    | 'signature-resizer';
  showFaceGuide?: boolean;
}

const {
  activePresetSlug = 'ssc-photo-resizer',
  initialSlotIndex = 0,
  initialMode = 'preset',
  showFaceGuide = false,
} = Astro.props;

const isGeneric = [
  'custom',
  'compressor',
  'signature-compressor',
  'photo-resizer',
  'image-resizer',
  'signature-resizer',
  'whitener',
].includes(initialMode);

// Normalise active preset
const initialPreset = presets.find(p => p.slug === activePresetSlug) || presets[0];
const allPresetsJson = JSON.stringify(presets);
---

<div
  id="workspace"
  class="w-full max-w-6xl mx-auto px-4 sm:px-6"
  data-all-presets={allPresetsJson}
  data-active-slug={activePresetSlug}
  data-initial-slot-index={initialSlotIndex}
  data-initial-mode={initialMode}
  data-show-face-guide={showFaceGuide ? 'true' : 'false'}
>
  <!-- Top Center Mode Selector (Only on homepage or exam presets / placard) -->
  {!isGeneric && (
    <div class="flex items-center justify-center mb-6">
      <div class="inline-flex p-1 bg-[#f0f0ee] border-2 border-[#e6e6e6] rounded-full shadow-inner gap-1">
        <button
          type="button"
          id="top-tab-resizer"
          class={`top-mode-btn px-6 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer ${
            initialMode !== 'placard'
              ? 'bg-white text-black shadow-xs'
              : 'text-neutral-600 hover:text-black'
          }`}
          data-topmode="resizer"
        >
          Image Resizer
        </button>
        <button
          type="button"
          id="top-tab-namedate"
          class={`top-mode-btn px-6 py-2 rounded-full text-xs sm:text-sm font-bold transition-all cursor-pointer ${
            initialMode === 'placard'
              ? 'bg-white text-black shadow-xs'
              : 'text-neutral-600 hover:text-black'
          }`}
          data-topmode="namedate"
        >
          Add Name &amp; Date
        </button>
      </div>
    </div>
  )}

  <!-- Main Studio Card: Figma Split Two-Column Container -->
  <div class="bg-white rounded-3xl border-2 border-[#e6e6e6] shadow-xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 transition-all">
    
    <!-- LEFT COLUMN: Step 1 Configuration (lg:col-span-5) -->
    <div class="lg:col-span-5 p-5 sm:p-6 bg-[#f7f7f5]/80 border-b lg:border-b-0 lg:border-r-2 border-[#e6e6e6] flex flex-col justify-between space-y-6">
      <div class="space-y-5">
        
        <!-- Step 1 Header -->
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="w-7 h-7 rounded-full bg-black text-white font-mono text-xs flex items-center justify-center font-bold">1</span>
            <div>
              <h2 class="text-base font-bold text-black tracking-tight leading-none">Configuration</h2>
              <span id="step1-subtitle" class="text-[11px] font-mono uppercase text-neutral-500 tracking-wider">
                {initialMode === 'placard' ? 'Name & Date' :
                 initialMode === 'compressor' ? 'Target File Size' :
                 initialMode === 'signature-compressor' ? 'Signature Settings' :
                 initialMode === 'photo-resizer' ? 'Photo Dimensions' :
                 initialMode === 'signature-resizer' ? 'Signature Dimensions' :
                 initialMode === 'image-resizer' ? 'Image Dimensions' :
                 initialMode === 'custom' ? 'Custom Dimensions' :
                 initialMode === 'whitener' ? 'Signature Whitener' :
                 'Exam & Doc Type'}
              </span>
            </div>
          </div>
          <!-- Figma Pill: Privacy guarantee -->
          <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-white border border-[#e6e6e6] rounded-full text-[11px] font-mono text-neutral-600 shadow-xs">
            <span class="w-2 h-2 rounded-full bg-[#1ea64a]"></span>
            <span>Client RAM</span>
          </div>
        </div>

        <!-- 1. DEDICATED ADD NAME & DATE PANEL (Clean, Zero Distraction, Exact ExamMint Image 1) -->
        <div id="panel-namedate-mode" class={`space-y-4 ${initialMode === 'placard' ? '' : 'hidden'}`}>
          <!-- Card 1: Add Name & Date Inputs -->
          <div class="p-5 bg-white border-2 border-black/10 rounded-2xl shadow-xs space-y-4">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-black text-white flex items-center justify-center font-bold text-xs">✓</span>
                <span class="text-xs font-bold text-black uppercase tracking-wider font-mono">Add Name &amp; Date</span>
              </div>
              <span class="px-2.5 py-0.5 rounded-full bg-[#f7f7f5] text-[10px] font-mono font-medium text-neutral-500 border border-[#e6e6e6]">
                Name or Date required
              </span>
            </div>

            <!-- Candidate Name -->
            <div class="space-y-1.5">
              <label for="namedate-name-input" class="text-xs font-bold text-neutral-700 block">
                Name (Block Letters)
              </label>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-neutral-400">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                </span>
                <input
                  type="text"
                  id="namedate-name-input"
                  placeholder="Enter your full name"
                  class="w-full pl-9 pr-3 py-2.5 text-xs bg-[#f7f7f5] hover:bg-white focus:bg-white border-2 border-[#e6e6e6] focus:border-black rounded-xl uppercase font-mono tracking-wide focus:outline-none transition-colors"
                />
              </div>
            </div>

            <!-- Date of Photo -->
            <div class="space-y-1.5">
              <div class="flex items-center justify-between">
                <label for="namedate-date-input" class="text-xs font-bold text-neutral-700">
                  Date of Photo
                </label>
                <label class="flex items-center gap-1.5 text-xs text-neutral-600 cursor-pointer select-none">
                  <input type="checkbox" id="namedate-include-date" checked class="w-3.5 h-3.5 rounded border-[#e6e6e6] text-black accent-black cursor-pointer" />
                  <span>Include Date</span>
                </label>
              </div>
              <div class="relative">
                <span class="absolute left-3 top-2.5 text-neutral-400">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                </span>
                <input
                  type="text"
                  id="namedate-date-input"
                  placeholder="DD-MM-YYYY"
                  class="w-full pl-9 pr-3 py-2.5 text-xs bg-[#f7f7f5] hover:bg-white focus:bg-white border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none transition-colors"
                />
              </div>
            </div>
          </div>

          <!-- Card 2: Resize Settings (Optional) -->
          <div class="p-5 bg-white border-2 border-dashed border-[#cccccc] hover:border-black rounded-2xl space-y-3 transition-colors">
            <div class="flex items-center justify-between">
              <div class="flex items-center gap-2">
                <span class="text-neutral-600">⚙️</span>
                <span class="text-xs font-bold text-black uppercase tracking-wider font-mono">Resize Settings</span>
                <span class="px-2 py-0.5 rounded-full bg-[#f7f7f5] text-[10px] font-mono text-neutral-500 border border-[#e6e6e6]">OPTIONAL</span>
              </div>
              <label class="flex items-center cursor-pointer">
                <input type="checkbox" id="namedate-enable-resize" class="w-4 h-4 rounded border-[#e6e6e6] text-black accent-black cursor-pointer" />
              </label>
            </div>

            <div id="namedate-resize-inputs" class="grid grid-cols-2 gap-3 opacity-50 pointer-events-none transition-opacity">
              <div>
                <label for="namedate-width-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Width (px)</label>
                <input
                  type="number"
                  id="namedate-width-input"
                  placeholder="Width"
                  value="350"
                  min="10"
                  max="4000"
                  class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                />
              </div>
              <div>
                <label for="namedate-height-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Height (px)</label>
                <input
                  type="number"
                  id="namedate-height-input"
                  placeholder="Height"
                  value="450"
                  min="10"
                  max="4000"
                  class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                />
              </div>
            </div>
            <p class="text-[11px] text-neutral-500 font-mono">Leave unchecked to keep original dimensions.</p>
          </div>
        </div>

        <!-- 2. GENERIC IMAGE COMPRESSOR PANEL -->
        {initialMode === 'compressor' && (
          <div id="panel-compressor-config" class="space-y-4">
            <div class="p-5 bg-white border-2 border-black/10 rounded-2xl shadow-xs space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-black uppercase tracking-wider font-mono">Target Compression Size</span>
                <span class="px-2.5 py-0.5 rounded-full bg-[#dceeb1] text-[10px] font-mono font-bold text-black border border-black/10">Zero Quality Loss</span>
              </div>

              <!-- Quick Target KB Presets -->
              <div class="space-y-1.5">
                <span class="text-[11px] font-mono text-neutral-500 block">Quick Target KB Presets:</span>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                  <button type="button" class="compressor-preset-btn px-2.5 py-2 rounded-xl text-xs font-bold font-mono border-2 border-[#e6e6e6] hover:border-black transition cursor-pointer" data-min="5" data-max="20">Under 20 KB</button>
                  <button type="button" class="compressor-preset-btn px-2.5 py-2 rounded-xl text-xs font-bold font-mono border-2 border-black bg-black text-white transition cursor-pointer" data-min="20" data-max="50">20–50 KB</button>
                  <button type="button" class="compressor-preset-btn px-2.5 py-2 rounded-xl text-xs font-bold font-mono border-2 border-[#e6e6e6] hover:border-black transition cursor-pointer" data-min="50" data-max="100">50–100 KB</button>
                  <button type="button" class="compressor-preset-btn px-2.5 py-2 rounded-xl text-xs font-bold font-mono border-2 border-[#e6e6e6] hover:border-black transition cursor-pointer" data-min="100" data-max="200">Under 200 KB</button>
                </div>
              </div>

              <!-- Custom Min/Max KB Input -->
              <div class="grid grid-cols-2 gap-3 pt-1">
                <div>
                  <label for="compressor-min-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Min File Size (KB)</label>
                  <input
                    type="number"
                    id="compressor-min-input"
                    value="20"
                    min="1"
                    max="2000"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                  />
                </div>
                <div>
                  <label for="compressor-max-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Max File Size (KB)</label>
                  <input
                    type="number"
                    id="compressor-max-input"
                    value="50"
                    min="2"
                    max="5000"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                  />
                </div>
              </div>

              <!-- Resolution & Format -->
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="compressor-dpi-select" class="text-[11px] font-bold text-neutral-600 block mb-1">DPI Resolution</label>
                  <select
                    id="compressor-dpi-select"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none cursor-pointer"
                  >
                    <option value="200" selected>200 DPI (Govt Standard)</option>
                    <option value="300">300 DPI (High Res)</option>
                    <option value="96">96 DPI (Web Standard)</option>
                  </select>
                </div>
                <div>
                  <label class="text-[11px] font-bold text-neutral-600 block mb-1">Target Format</label>
                  <div class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] rounded-xl font-mono text-neutral-800 flex items-center justify-between">
                    <span>JPG Baseline</span>
                    <span class="text-[10px] text-neutral-400">JFIF</span>
                  </div>
                </div>
              </div>

              <p class="text-[11px] text-neutral-500 font-mono">
                Binary-search quantization tests compression ratios in real-time inside your browser to strictly hit your target size.
              </p>
            </div>
          </div>
        )}

        <!-- 3. GENERIC SIGNATURE COMPRESSOR PANEL -->
        {initialMode === 'signature-compressor' && (
          <div id="panel-sigcompress-config" class="space-y-4">
            <div class="p-5 bg-white border-2 border-black/10 rounded-2xl shadow-xs space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-black uppercase tracking-wider font-mono">Signature Settings</span>
                <span class="px-2.5 py-0.5 rounded-full bg-[#dceeb1] text-[10px] font-mono font-bold text-black border border-black/10">Govt Format</span>
              </div>

              <!-- Quick Presets -->
              <div class="space-y-1.5">
                <span class="text-[11px] font-mono text-neutral-500 block">Target File Size:</span>
                <div class="grid grid-cols-3 gap-2">
                  <button type="button" class="sig-kb-preset-btn px-2 py-2 rounded-xl text-xs font-bold font-mono border-2 border-black bg-black text-white transition cursor-pointer" data-min="10" data-max="20">10–20 KB</button>
                  <button type="button" class="sig-kb-preset-btn px-2 py-2 rounded-xl text-xs font-bold font-mono border-2 border-[#e6e6e6] hover:border-black transition cursor-pointer" data-min="20" data-max="50">20–50 KB</button>
                  <button type="button" class="sig-kb-preset-btn px-2 py-2 rounded-xl text-xs font-bold font-mono border-2 border-[#e6e6e6] hover:border-black transition cursor-pointer" data-min="10" data-max="100">Under 100 KB</button>
                </div>
              </div>

              <!-- Custom Min/Max KB -->
              <div class="grid grid-cols-2 gap-3 pt-1">
                <div>
                  <label for="sigcompress-min-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Min KB</label>
                  <input
                    type="number"
                    id="sigcompress-min-input"
                    value="10"
                    min="1"
                    max="500"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                  />
                </div>
                <div>
                  <label for="sigcompress-max-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Max KB</label>
                  <input
                    type="number"
                    id="sigcompress-max-input"
                    value="20"
                    min="2"
                    max="1000"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                  />
                </div>
              </div>

              <!-- Whitener Feature -->
              <div class="p-3 bg-[#f7f7f5] border border-[#e6e6e6] rounded-xl space-y-2">
                <div class="flex items-center justify-between">
                  <label class="flex items-center gap-2 cursor-pointer select-none">
                    <input type="checkbox" id="sigcompress-enable-whitener" checked class="w-4 h-4 rounded border-[#e6e6e6] text-black accent-black cursor-pointer" />
                    <span class="text-xs font-bold text-black font-mono">✨ Auto-Whiten Paper</span>
                  </label>
                  <span class="text-[10px] font-mono text-neutral-500">200 DPI</span>
                </div>
                <p class="text-[11px] text-neutral-600 font-mono">Removes grey shadows, yellow casts, and dirty phone paper automatically.</p>
              </div>

              <!-- Dimensions option -->
              <label class="flex items-center gap-2 cursor-pointer select-none text-xs font-mono text-neutral-700">
                <input type="checkbox" id="sigcompress-standard-dims" checked class="w-4 h-4 rounded border-[#e6e6e6] text-black accent-black cursor-pointer" />
                <span>Standard 140 × 60 px ratio (SSC / IBPS standard)</span>
              </label>
            </div>
          </div>
        )}

        <!-- 4. CUSTOM / GENERIC RESIZER CONFIG PANEL -->
        {['custom', 'photo-resizer', 'image-resizer', 'signature-resizer', 'whitener'].includes(initialMode) && (
          <div id="panel-custom-config" class="space-y-4">
            <div class="p-4 bg-white border-2 border-[#e6e6e6] rounded-2xl space-y-3">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-black uppercase tracking-wider font-mono">Target Dimensions</span>
                <div class="flex items-center gap-1 text-xs">
                  <span class="text-neutral-500 mr-1 font-mono text-[11px]">Unit:</span>
                  <button type="button" class="unit-btn px-2 py-0.5 rounded text-xs font-bold bg-black text-white" data-unit="px">px</button>
                  <button type="button" class="unit-btn px-2 py-0.5 rounded text-xs font-medium bg-[#f7f7f5] text-black hover:bg-neutral-200" data-unit="cm">cm</button>
                  <button type="button" class="unit-btn px-2 py-0.5 rounded text-xs font-medium bg-[#f7f7f5] text-black hover:bg-neutral-200" data-unit="mm">mm</button>
                  <button type="button" class="unit-btn px-2 py-0.5 rounded text-xs font-medium bg-[#f7f7f5] text-black hover:bg-neutral-200" data-unit="inch">in</button>
                </div>
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="custom-width-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Width (<span class="unit-label">px</span>)</label>
                  <input
                    type="number"
                    id="custom-width-input"
                    value={initialMode === 'signature-resizer' || initialMode === 'whitener' ? '140' : '350'}
                    min="10"
                    max="4000"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                  />
                </div>
                <div>
                  <label for="custom-height-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Height (<span class="unit-label">px</span>)</label>
                  <input
                    type="number"
                    id="custom-height-input"
                    value={initialMode === 'signature-resizer' || initialMode === 'whitener' ? '60' : '450'}
                    min="10"
                    max="4000"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                  />
                </div>
                <div>
                  <label for="custom-minkb-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Min KB</label>
                  <input
                    type="number"
                    id="custom-minkb-input"
                    value={initialMode === 'signature-resizer' || initialMode === 'whitener' ? '10' : '20'}
                    min="1"
                    max="2000"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                  />
                </div>
                <div>
                  <label for="custom-maxkb-input" class="text-[11px] font-bold text-neutral-600 block mb-1">Max KB</label>
                  <input
                    type="number"
                    id="custom-maxkb-input"
                    value={initialMode === 'signature-resizer' || initialMode === 'whitener' ? '20' : (initialMode === 'image-resizer' ? '100' : '50')}
                    min="2"
                    max="5000"
                    class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none"
                  />
                </div>
              </div>

              <div>
                <label for="custom-dpi-select" class="text-[11px] font-bold text-neutral-600 block mb-1">Resolution (DPI)</label>
                <select
                  id="custom-dpi-select"
                  class="w-full px-3 py-2 text-xs bg-[#f7f7f5] border-2 border-[#e6e6e6] focus:border-black rounded-xl font-mono focus:outline-none cursor-pointer"
                >
                  <option value="200" selected>200 DPI (UPSC / SSC / Banking Standard)</option>
                  <option value="300">300 DPI (High Resolution Print)</option>
                  <option value="600">600 DPI (Strict Biometric)</option>
                  <option value="96">96 DPI (Standard Web)</option>
                </select>
              </div>

              <div class="flex items-center gap-4 pt-1 text-xs text-neutral-700">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="custom-lock-ratio" checked class="w-4 h-4 text-black rounded border-[#e6e6e6] accent-black" />
                  <span>Lock ratio</span>
                </label>
                <label class="flex items-center gap-2 cursor-pointer">
                  <input type="checkbox" id="custom-pad-white" class="w-4 h-4 text-black rounded border-[#e6e6e6] accent-black" />
                  <span>Fit with white borders</span>
                </label>
              </div>
            </div>
          </div>
        )}

        <!-- 5. EXAM PRESET MODE PANEL (Only on official exam preset routes) -->
        {!isGeneric && initialMode !== 'placard' && (
          <div id="panel-resizer-mode" class="space-y-4">
            
            <!-- Selected Exam Card with < Change Button -->
            <div id="selected-exam-bar" class="p-4 bg-white border-2 border-black/10 rounded-2xl flex items-center justify-between shadow-xs">
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-full bg-black text-white flex items-center justify-center font-bold text-sm shadow-xs">
                  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                </div>
                <div>
                  <span class="text-[10px] text-neutral-500 uppercase font-mono block">Selected Exam</span>
                  <span id="selected-exam-title-text" class="text-sm font-bold text-black">{initialPreset.shortTitle || initialPreset.exam}</span>
                </div>
              </div>
              <button
                type="button"
                id="btn-change-exam"
                class="px-3.5 py-1.5 rounded-full text-xs font-bold text-black hover:bg-[#f7f7f5] border border-[#e6e6e6] hover:border-black transition-colors cursor-pointer flex items-center gap-1"
              >
                <svg id="btn-change-icon" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="15 18 9 12 15 6"/></svg>
                <span id="btn-change-text">Change</span>
              </button>
            </div>

            <!-- Collapsible Exam Picker Grid (Reveals when < Change is clicked) -->
            <div id="exam-picker-collapsible" class="space-y-3 bg-white p-4 border-2 border-[#e6e6e6] rounded-2xl hidden">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-black uppercase tracking-wider font-mono">Select Target Exam</span>
                <span id="exam-count-badge" class="text-[11px] font-mono text-neutral-500">{presets.length} Presets</span>
              </div>

              <!-- Search Input -->
              <div class="relative">
                <input
                  type="text"
                  id="exam-search-input"
                  placeholder="Search exams (UPSC, SSC, GDS, IBPS, NEET...)"
                  class="w-full pl-9 pr-3 py-2 text-xs bg-[#f7f7f5] hover:bg-white focus:bg-white border-2 border-[#e6e6e6] focus:border-black rounded-xl transition-colors focus:outline-none"
                />
                <svg class="w-4 h-4 absolute left-3 top-2.5 text-neutral-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="11" cy="11" r="8" />
                  <line x1="21" y1="21" x2="16.65" y2="16.65" />
                </svg>
              </div>

              <!-- Category Filter Pills (Zero Horizontal Scrollbar) -->
              <div class="flex flex-wrap items-center gap-1.5 text-xs">
                <button type="button" class="cat-filter-btn px-3 py-1 rounded-full text-xs font-bold bg-black text-white transition-all cursor-pointer" data-cat="all">All</button>
                <button type="button" class="cat-filter-btn px-3 py-1 rounded-full text-xs font-medium bg-[#f7f7f5] text-black border border-[#e6e6e6] hover:border-black transition-all cursor-pointer" data-cat="ssc">SSC</button>
                <button type="button" class="cat-filter-btn px-3 py-1 rounded-full text-xs font-medium bg-[#f7f7f5] text-black border border-[#e6e6e6] hover:border-black transition-all cursor-pointer" data-cat="banking">Banking</button>
                <button type="button" class="cat-filter-btn px-3 py-1 rounded-full text-xs font-medium bg-[#f7f7f5] text-black border border-[#e6e6e6] hover:border-black transition-all cursor-pointer" data-cat="upsc">UPSC</button>
                <button type="button" class="cat-filter-btn px-3 py-1 rounded-full text-xs font-medium bg-[#f7f7f5] text-black border border-[#e6e6e6] hover:border-black transition-all cursor-pointer" data-cat="police">Police</button>
                <button type="button" class="cat-filter-btn px-3 py-1 rounded-full text-xs font-medium bg-[#f7f7f5] text-black border border-[#e6e6e6] hover:border-black transition-all cursor-pointer" data-cat="central">Central</button>
                <button type="button" class="cat-filter-btn px-3 py-1 rounded-full text-xs font-medium bg-[#f7f7f5] text-black border border-[#e6e6e6] hover:border-black transition-all cursor-pointer" data-cat="state">State</button>
              </div>

              <!-- Straight 2-Column Grid of Exam Cards (NO SCROLL CONTAINER) -->
              <div id="exam-pills-list" class="grid grid-cols-2 gap-2 pt-1">
                {presets.map((p, idx) => (
                  <a
                    href={`/${p.slug}`}
                    class={`exam-card-btn p-2.5 rounded-xl text-left border-2 transition-all cursor-pointer group flex flex-col justify-between ${
                      idx >= 8 ? 'hidden-exam hidden' : ''
                    } ${
                      p.slug === initialPreset.slug
                        ? 'bg-black text-white border-black font-semibold shadow-xs'
                        : 'bg-white text-black border-[#e6e6e6] hover:border-black hover:bg-[#f7f7f5]'
                    }`}
                    data-slug={p.slug}
                    data-cat={p.category}
                    data-index={idx}
                    data-search={`${p.title} ${p.exam} ${p.categoryLabel} ${p.shortTitle}`.toLowerCase()}
                  >
                    <span class="text-xs font-bold block truncate">{p.shortTitle || p.exam}</span>
                    <span class={`text-[10px] block truncate font-mono mt-0.5 ${p.slug === initialPreset.slug ? 'text-neutral-300' : 'text-neutral-500'}`}>{p.categoryLabel}</span>
                  </a>
                ))}
                <!-- Custom Size link inside grid -->
                <a
                  href="/custom"
                  id="btn-exam-custom-card"
                  class="exam-card-btn p-2.5 rounded-xl text-left border-2 border-dashed border-[#888888] hover:border-black bg-white hover:bg-[#f7f7f5] text-black transition-all cursor-pointer flex flex-col justify-between"
                  data-slug="custom-mode"
                >
                  <span class="text-xs font-bold block truncate">⚙️ Custom Size</span>
                  <span class="text-[10px] block truncate font-mono mt-0.5 text-neutral-500">Any px or KB</span>
                </a>
              </div>

              <!-- Straight Expand/Collapse Button (Zero Scroll) -->
              <button
                type="button"
                id="btn-toggle-all-exams"
                class="w-full py-2 rounded-xl border border-dashed border-[#cccccc] hover:border-black text-neutral-600 hover:text-black text-xs font-semibold font-mono text-center transition cursor-pointer"
              >
                + View All Exams ({presets.length} Presets)
              </button>
            </div>

            <!-- Document Type Selector (Exact ExamMint Image 3 & 4) -->
            <div id="doc-type-section" class="space-y-2 pt-1">
              <div class="flex items-center justify-between">
                <span class="text-xs font-bold text-black uppercase tracking-wider font-mono">Choose Document Type</span>
                <span id="active-slot-counter" class="text-[11px] font-mono text-neutral-500">1 of {initialPreset.slots.length}</span>
              </div>
              <div id="doc-type-grid" class="grid grid-cols-2 gap-3">
                <!-- Dynamically populated document cards via renderSlotPills() -->
              </div>
            </div>

            <!-- Image Requirements Card (Exact ExamMint Image 4) -->
            <div id="image-requirements-card" class="p-4 bg-white border-2 border-[#e6e6e6] rounded-2xl space-y-2">
              <div class="flex items-center gap-2 text-xs font-mono font-semibold text-neutral-500 uppercase border-b border-[#f1f1f1] pb-2">
                <span class="text-black font-bold">ℹ️ Image Requirements</span>
              </div>
              <div class="grid grid-cols-3 gap-2 text-center pt-1">
                <div class="p-2 bg-[#f7f7f5] rounded-xl border border-[#e6e6e6]">
                  <span class="text-[10px] text-neutral-500 uppercase font-mono block">Dimensions</span>
                  <span id="spec-dimensions" class="text-xs font-bold text-black font-mono mt-0.5 block">{initialPreset.slots[0].widthPx}×{initialPreset.slots[0].heightPx} px</span>
                </div>
                <div class="p-2 bg-[#f7f7f5] rounded-xl border border-[#e6e6e6]">
                  <span class="text-[10px] text-neutral-500 uppercase font-mono block">Size</span>
                  <span id="spec-filesize" class="text-xs font-bold text-black font-mono mt-0.5 block">{initialPreset.slots[0].minKB}–{initialPreset.slots[0].maxKB} KB</span>
                </div>
                <div class="p-2 bg-[#dceeb1] rounded-xl border border-black/10">
                  <span class="text-[10px] text-neutral-700 uppercase font-mono block">Format</span>
                  <span id="spec-dpi" class="text-xs font-bold text-black font-mono mt-0.5 block">JPG · {initialPreset.slots[0].dpi} DPI</span>
                </div>
              </div>
              <div id="spec-notes" class="text-[11px] text-neutral-600 leading-snug pt-1">
                {initialPreset.slots[0].notes || 'Ensure clear passport composition with neutral background.'}
              </div>
            </div>
          </div>
        )}

        <!-- Universal Image Adjustments Card (Always available) -->
        <div id="image-adjustments-card" class="p-4 bg-white border-2 border-[#e6e6e6] rounded-2xl space-y-3">
          <span class="text-[10px] font-mono font-bold text-neutral-500 uppercase tracking-wider block">Image Adjustments</span>
          <div class="space-y-3">
            <div>
              <div class="flex justify-between text-[11px] font-mono text-neutral-600 mb-1">
                <span>Brightness</span>
                <span id="brightness-val-text" class="font-bold text-black">0</span>
              </div>
              <input type="range" id="brightness-slider" min="-50" max="50" value="0" class="w-full accent-black h-1.5 bg-[#f7f7f5] rounded-lg cursor-pointer" />
            </div>
            <div>
              <div class="flex justify-between text-[11px] font-mono text-neutral-600 mb-1">
                <span>Contrast</span>
                <span id="contrast-val-text" class="font-bold text-black">0</span>
              </div>
              <input type="range" id="contrast-slider" min="-50" max="50" value="0" class="w-full accent-black h-1.5 bg-[#f7f7f5] rounded-lg cursor-pointer" />
            </div>
            <div id="whitener-adjustment-box" class={initialMode === 'signature-compressor' || initialMode === 'signature-resizer' || initialMode === 'whitener' ? '' : 'hidden'}>
              <div class="flex justify-between text-[11px] font-mono text-neutral-600 mb-1">
                <span>Signature Clean Up</span>
                <span id="whitener-val-text" class="font-bold text-black">220</span>
              </div>
              <input type="range" id="whitener-slider" min="140" max="245" value="220" class="w-full accent-black h-1.5 bg-[#f7f7f5] rounded-lg cursor-pointer" />
              <span class="text-[9px] text-neutral-400 font-mono block mt-0.5">Cleans shadow casts or yellow paper to pure white.</span>
            </div>
          </div>
        </div>

      </div>

      <!-- Footer Help Link -->
      <div class="pt-4 border-t border-[#e6e6e6] flex items-center justify-between text-[11px] text-neutral-500 font-mono">
        {isGeneric ? (
          <a href="/" class="text-black font-semibold hover:underline flex items-center gap-1">
            <span>Looking for a specific exam? Browse 38+ Exams</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        ) : (
          <a id="exam-full-guide-link" href={`/${initialPreset.slug}`} class="text-black font-semibold hover:underline flex items-center gap-1">
            <span>Read Official Guidelines</span>
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        )}
        <span>Zero Storage</span>
      </div>
    </div>


    <!-- RIGHT COLUMN: Step 2 Upload & Process Studio (lg:col-span-7) -->
    <div class="lg:col-span-7 p-6 sm:p-8 bg-white flex flex-col justify-start space-y-6">
      
      <!-- Step 2 Header -->
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full bg-black text-white font-mono text-xs flex items-center justify-center font-bold">2</span>
          <div>
            <h2 class="text-base font-bold text-black tracking-tight leading-none">Upload &amp; Process</h2>
            <span class="text-[11px] font-mono uppercase text-neutral-500 tracking-wider">Drag, Crop &amp; Verify</span>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <!-- Reset button (visible when image loaded) -->
          <button id="cancel-opening-image" type="button" class="text-xs text-neutral-500 hover:text-black font-medium transition cursor-pointer hidden">
            Choose Another Image
          </button>
        </div>
      </div>

      <!-- STAGE 1: Drag & Drop Upload Zone -->
      <div id="upload-container" class="space-y-4">
        <div
          id="drop-zone"
          class="border-2 border-dashed border-[#cccccc] hover:border-black bg-[#fafafa] hover:bg-white rounded-3xl p-8 sm:p-14 transition-all cursor-pointer flex flex-col items-center justify-center gap-4 text-center group min-h-[360px]"
          tabindex="0"
          role="button"
          aria-label="Upload document image"
        >
          <div class="w-16 h-16 rounded-full bg-white border-2 border-[#e6e6e6] flex items-center justify-center text-black shadow-xs group-hover:scale-105 group-hover:border-black transition-all">
            <svg class="w-7 h-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <polyline points="17 8 12 3 7 8" />
              <line x1="12" y1="3" x2="12" y2="15" />
            </svg>
          </div>

          <div class="space-y-1.5 max-w-sm">
            <p id="upload-headline" class="text-base sm:text-lg font-bold text-black">
              Drop photo or signature here
            </p>
            <p class="text-xs text-neutral-500 leading-relaxed">
              Supports JPG, PNG, WEBP, HEIC up to 25 MB · Instant client-side RAM execution
            </p>
          </div>

          <button
            type="button"
            class="mt-2 px-7 py-2.5 rounded-full bg-black hover:bg-[#222222] text-white text-xs sm:text-sm font-bold shadow-md transition-all active:scale-95 cursor-pointer"
          >
            Browse Files
          </button>
          <input type="file" id="file-input" class="hidden" accept="image/jpeg,image/png,image/webp,image/heic,image/heif" />
        </div>

        <!-- Quick Sample Specimen & Camera Row -->
        <div class="flex items-center justify-center gap-3 pt-1 flex-wrap">
          <button id="btn-sample" type="button" class="px-4 py-1.5 rounded-full bg-[#f7f7f5] hover:bg-black hover:text-white border border-[#e6e6e6] text-xs font-semibold text-black transition-colors cursor-pointer flex items-center gap-1.5">
            <span>🧪 Try Sample Photo</span>
          </button>
          <button id="btn-sample-sig" type="button" class="px-4 py-1.5 rounded-full bg-[#f7f7f5] hover:bg-black hover:text-white border border-[#e6e6e6] text-xs font-semibold text-black transition-colors cursor-pointer flex items-center gap-1.5">
            <span>✍️ Try Sample Signature</span>
          </button>
          <button id="btn-camera" type="button" class="px-4 py-1.5 rounded-full bg-[#f7f7f5] hover:bg-black hover:text-white border border-[#e6e6e6] text-xs font-semibold text-black transition-colors cursor-pointer flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <span>Live Camera</span>
          </button>
        </div>
      </div>


      <!-- STAGE 2: Precision Cropper Studio (Exact ExamMint Image 4) -->
      <div id="image-editor-container" class="space-y-4 hidden">
        
        <!-- File Name Bar (Exact ExamMint Image 4) -->
        <div id="cropper-file-bar" class="p-3 px-4 bg-white border-2 border-[#e6e6e6] rounded-2xl flex items-center justify-between text-xs font-mono shadow-xs">
          <div class="flex items-center gap-2 truncate">
            <span class="text-neutral-400">📄</span>
            <span id="cropper-filename-display" class="truncate font-bold text-black">document.jpg (0 KB)</span>
          </div>
          <button id="cropper-file-close-btn" type="button" class="text-neutral-400 hover:text-black font-bold text-sm cursor-pointer ml-2 p-1" title="Close Image">✕</button>
        </div>

        <div class="flex items-center justify-between text-xs flex-wrap gap-2">
          <span class="font-bold text-black uppercase font-mono tracking-wider">Crop &amp; Adjust</span>
          <div class="flex items-center gap-2">
            <!-- 75% Biometric Face Coverage Toggle Button -->
            <button
              id="btn-toggle-face-guide"
              type="button"
              class={`px-3 py-1.5 rounded-full border text-xs font-semibold font-mono transition-colors flex items-center gap-1.5 cursor-pointer ${
                showFaceGuide
                  ? 'bg-black text-white border-black'
                  : 'bg-white hover:bg-black hover:text-white border-[#e6e6e6] text-black'
              }`}
              title="Toggle 75% Biometric Face Coverage Guide (UPSC / SSC / NTA Standard)"
            >
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="8" r="5" />
                <path d="M20 21a8 8 0 0 0-16 0" />
              </svg>
              <span id="face-guide-toggle-text">{showFaceGuide ? 'Face Guide: ON' : '75% Face Guide'}</span>
            </button>

            <button id="btn-rotate-left" type="button" class="w-8 h-8 rounded-full bg-white hover:bg-black hover:text-white border border-[#e6e6e6] text-black transition-colors flex items-center justify-center cursor-pointer" title="Rotate Counter-Clockwise (-90°)">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2.5 2v6h6M2.66 15.57a10 10 0 1 0 .57-8.38"/></svg>
            </button>
            <button id="btn-rotate-right" type="button" class="w-8 h-8 rounded-full bg-white hover:bg-black hover:text-white border border-[#e6e6e6] text-black transition-colors flex items-center justify-center cursor-pointer" title="Rotate Clockwise (+90°)">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21.5 2v6h-6M21.34 15.57a10 10 0 1 1-.57-8.38"/></svg>
            </button>
            <button id="btn-reset-crop" type="button" class="w-8 h-8 rounded-full bg-white hover:bg-black hover:text-white border border-[#e6e6e6] text-black transition-colors flex items-center justify-center cursor-pointer" title="Reset Zoom">
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
            </button>
          </div>
        </div>

        <!-- Cropper Viewport -->
        <div class="relative bg-black rounded-2xl overflow-hidden min-h-[300px] sm:min-h-[360px] max-h-[460px] w-full flex items-center justify-center border-2 border-black">
          <img id="cropper-image" alt="Source Document" class="max-w-full block max-h-full" />

          <!-- Subtle Non-Intrusive 75%–80% Face Coverage Guide Overlay -->
          <div
            id="face-guide-overlay"
            class={`absolute inset-0 pointer-events-none flex flex-col items-center justify-center z-20 transition-opacity select-none ${
              showFaceGuide ? '' : 'hidden'
            }`}
          >
            <div class="relative w-48 sm:w-56 h-64 sm:h-72 flex flex-col items-center justify-center">
              <svg class="w-full h-full text-white drop-shadow-md" viewBox="0 0 200 260" fill="none">
                <!-- Top Crown Boundary -->
                <line x1="55" y1="26" x2="145" y2="26" stroke="#ffffff" stroke-width="1.8" stroke-dasharray="3 3" opacity="0.9"/>
                <text x="100" y="20" font-size="8" fill="#ffffff" text-anchor="middle" font-family="monospace" font-weight="bold" letter-spacing="0.5">TOP OF HEAD (CROWN)</text>

                <!-- Biometric Head Oval (75-80% height) -->
                <ellipse cx="100" cy="98" rx="52" ry="72" stroke="#ffffff" stroke-width="2" stroke-dasharray="6 4" opacity="0.85" />
                
                <!-- Eye Level Line -->
                <line x1="45" y1="90" x2="155" y2="90" stroke="#ffffff" stroke-width="1.2" stroke-dasharray="2 3" opacity="0.75"/>
                <text x="158" y="93" font-size="7" fill="#ffffff" opacity="0.9" font-family="monospace">EYE LEVEL</text>

                <!-- Bottom Chin Boundary -->
                <line x1="65" y1="170" x2="135" y2="170" stroke="#ffffff" stroke-width="1.8" stroke-dasharray="3 3" opacity="0.9"/>
                <text x="100" y="182" font-size="8" fill="#ffffff" text-anchor="middle" font-family="monospace" font-weight="bold" letter-spacing="0.5">CHIN LINE (75%-80%)</text>

                <!-- Shoulder Arcs -->
                <path d="M 20 250 C 45 205 68 194 88 188 C 100 188 100 188 112 188 C 132 194 155 205 180 250" stroke="#ffffff" stroke-width="1.8" stroke-dasharray="4 4" opacity="0.75" />
              </svg>
              <div class="absolute bottom-2 px-3 py-1 rounded-full bg-black/80 backdrop-blur-sm border border-white/20 text-[10px] font-mono text-white text-center shadow-lg">
                Official 75%–80% Face Area Guide
              </div>
            </div>
          </div>
        </div>

        <!-- Action Buttons (Cancel + Apply & Optimize) -->
        <div class="flex items-center gap-3">
          <button
            id="btn-cancel-crop"
            type="button"
            class="py-3.5 px-6 rounded-full bg-white hover:bg-[#f7f7f5] text-black border-2 border-[#e6e6e6] hover:border-black font-bold text-sm transition-all cursor-pointer"
          >
            Cancel
          </button>
          <button
            id="btn-apply-crop"
            type="button"
            class="btn-apply-crop-action flex-1 py-3.5 rounded-full bg-black hover:bg-[#222222] active:scale-[0.98] text-white font-bold text-sm sm:text-base shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span id="btn-apply-crop-text">Apply &amp; Optimize</span>
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
          </button>
        </div>
      </div>


      <!-- Processing Spinner -->
      <div id="processing-loader" class="text-center py-20 space-y-4 hidden">
        <div class="w-10 h-10 border-3 border-black border-t-transparent rounded-full animate-spin mx-auto"></div>
        <div class="space-y-1">
          <p class="text-sm font-bold text-black">Executing Binary Search Engine...</p>
          <p class="text-xs font-mono text-neutral-500">Injecting exact DPI header &amp; targeting strict KB window</p>
        </div>
      </div>


      <!-- STAGE 3: Verified Result & Download (ExamMint 4-point Checklist Replication) -->
      <div id="preview-container" class="space-y-6 hidden">
        
        <!-- Official Portal Audit Receipt -->
        <div class="p-4 bg-[#f7f7f5] border-2 border-black rounded-2xl space-y-3">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <span class="w-2.5 h-2.5 rounded-full bg-[#1ea64a]"></span>
              <span class="text-xs font-bold text-black uppercase font-mono tracking-wider">Official Portal Audit Passed</span>
            </div>
            <span id="res-quality-tag" class="text-xs font-mono px-2.5 py-0.5 rounded-full bg-white text-black font-bold border border-black/20">
              Q: 92%
            </span>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-1 text-xs">
            <div class="p-2 bg-white rounded-xl border border-[#e6e6e6]">
              <span class="text-[10px] text-neutral-500 uppercase font-mono block">Dimensions</span>
              <span id="res-audit-dims" class="font-bold text-black font-mono mt-0.5 block">--</span>
            </div>
            <div class="p-2 bg-white rounded-xl border border-[#e6e6e6]">
              <span class="text-[10px] text-neutral-500 uppercase font-mono block">File Size</span>
              <span id="res-audit-kb" class="font-bold text-black font-mono mt-0.5 block">--</span>
            </div>
