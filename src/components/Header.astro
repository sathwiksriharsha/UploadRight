---
// UploadRight Header — Figma Design System Navbar
// Design System: Monochrome editorial frame, hairline border (#e6e6e6), pill CTAs (rounded-full)
---

<header
  class="bg-white/95 backdrop-blur-md border-b-2 border-[#e6e6e6] sticky top-0 z-50"
>
  <div
    class="max-w-6xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between"
  >
    <!-- Brand Logo -->
    <a
      href="/"
      class="flex items-center gap-2.5 group focus:outline-none"
      aria-label="UploadRight Home"
    >
      <div
        class="w-8 h-8 rounded-full bg-black flex items-center justify-center text-white shadow-xs group-hover:scale-105 transition-transform"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="16"
          height="16"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
          <polyline points="17 8 12 3 7 8"></polyline>
          <line x1="12" y1="3" x2="12" y2="15"></line>
        </svg>
      </div>
      <span
        class="font-black text-lg text-black tracking-tight flex items-center gap-1.5"
      >
        UploadRight
        <span
          class="inline-block w-2 h-2 rounded-full bg-[#1ea64a]"
          title="100% Client-Side Privacy"></span>
      </span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav
      class="hidden lg:flex items-center gap-5 text-xs font-bold text-neutral-600 font-mono uppercase tracking-wider"
    >
      <a href="/central" class="hover:text-black transition-colors">Central</a>
      <a href="/banking" class="hover:text-black transition-colors">Banking</a>
      <a href="/police" class="hover:text-black transition-colors">Police</a>
      <a href="/state" class="hover:text-black transition-colors">State PSC</a>
      <a href="/judiciary" class="hover:text-black transition-colors">Judiciary</a>

      <!-- Tools Dropdown (Exact user reference screenshot) -->
      <div class="relative group">
        <button type="button" class="flex items-center gap-1 hover:text-black transition-colors font-bold uppercase tracking-wider py-2 cursor-pointer">
          <span>Tools</span>
          <svg class="w-3.5 h-3.5 group-hover:rotate-180 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="absolute right-0 top-full mt-1 w-64 bg-white border-2 border-[#e6e6e6] rounded-2xl shadow-xl py-2 hidden group-hover:block z-50 normal-case font-sans">
          <a href="/photo-resizer" class="block px-4 py-2.5 text-xs font-bold text-black hover:bg-[#f7f7f5] transition-colors">Photo &amp; Image Resizer</a>
          <a href="/signature-resizer" class="block px-4 py-2.5 text-xs font-bold text-black hover:bg-[#f7f7f5] transition-colors">Signature Resizer</a>
          <a href="/image-compressor" class="block px-4 py-2.5 text-xs font-bold text-black hover:bg-[#f7f7f5] transition-colors">Image Compressor</a>
          <a href="/signature-compressor" class="block px-4 py-2.5 text-xs font-bold text-black hover:bg-[#f7f7f5] transition-colors">Signature Compressor</a>
          <a href="/75-face-coverage" class="block px-4 py-2.5 text-xs font-bold text-black hover:bg-[#f7f7f5] transition-colors">75% Face Coverage</a>
          <a href="/add-name-date" class="block px-4 py-2.5 text-xs font-bold text-black hover:bg-[#f7f7f5] transition-colors">Add Name &amp; Date</a>
          <div class="border-t border-[#e6e6e6] my-1"></div>
          <a href="/custom" class="block px-4 py-2 text-[11px] font-semibold text-neutral-500 hover:text-black hover:bg-[#f7f7f5] transition-colors font-mono">Custom Dimensions &amp; KB</a>
          <a href="/signature-whitener" class="block px-4 py-2 text-[11px] font-semibold text-neutral-500 hover:text-black hover:bg-[#f7f7f5] transition-colors font-mono">Paper Whitener</a>
        </div>
      </div>
    </nav>

    <!-- Right Side CTA & Mobile Toggle -->
    <div class="flex items-center gap-3">
      <a
        href="/#workspace"
        class="hidden sm:inline-flex items-center gap-2 px-5 py-2 rounded-full bg-black text-white hover:bg-neutral-800 text-xs font-bold transition shadow-xs active:scale-95 cursor-pointer"
      >
        <span>Open Resizer Studio</span>
        <svg
          class="w-3.5 h-3.5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"><polyline points="9 18 15 12 9 6"></polyline></svg
        >
      </a>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="lg:hidden p-2 text-black hover:bg-[#f7f7f5] rounded-full border border-[#e6e6e6] transition-colors"
        aria-label="Toggle navigation"
      >
        <svg
          id="menu-icon"
          class="w-5 h-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
        <svg
          id="close-icon"
          class="w-5 h-5 hidden"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.5"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Dropdown -->
  <div
    id="mobile-menu"
    class="hidden lg:hidden bg-white border-b-2 border-[#e6e6e6] px-5 py-4 space-y-2 text-xs font-bold font-mono uppercase"
  >
    <div class="grid grid-cols-2 gap-2 pb-2 border-b border-[#e6e6e6]">
      <a href="/central" class="block p-2 rounded-xl bg-[#f7f7f5] text-black"
        >Central Govt</a
      >
      <a href="/banking" class="block p-2 rounded-xl bg-[#f7f7f5] text-black"
        >Banking Exams</a
      >
      <a href="/police" class="block p-2 rounded-xl bg-[#f7f7f5] text-black"
        >Police &amp; SI</a
      >
      <a href="/state" class="block p-2 rounded-xl bg-[#f7f7f5] text-black"
        >State PSCs</a
      >
      <a href="/judiciary" class="block p-2 rounded-xl bg-[#f7f7f5] text-black"
        >Judiciary</a
      >
      <a href="/custom" class="block p-2 rounded-xl bg-[#f7f7f5] text-black"
        >Custom Resizer</a
      >
    </div>
    <div class="space-y-1.5 pt-1">
      <a
        href="/photo-resizer"
        class="block py-1 text-neutral-600 hover:text-black">Photo Resizer</a
      >
      <a
        href="/signature-resizer"
        class="block py-1 text-neutral-600 hover:text-black"
        >Signature Resizer</a
      >
      <a
        href="/signature-whitener"
        class="block py-1 text-neutral-600 hover:text-black"
        >Signature Whitener</a
      >
      <a
        href="/add-name-date"
        class="block py-1 text-neutral-600 hover:text-black"
        >Add Name &amp; Date Slate</a
      >
      <a
        href="/75-face-coverage"
        class="block py-1 text-neutral-600 hover:text-black"
        >75% Face Coverage</a
      >
      <a href="/supported" class="block py-1 text-neutral-600 hover:text-black"
        >All Supported Exams</a
      >
    </div>
  </div>
</header>

<script>
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const mobileMenu = document.getElementById("mobile-menu");
  const menuIcon = document.getElementById("menu-icon");
  const closeIcon = document.getElementById("close-icon");

  if (mobileBtn && mobileMenu && menuIcon && closeIcon) {
    mobileBtn.addEventListener("click", () => {
      const isOpen = !mobileMenu.classList.contains("hidden");
      mobileMenu.classList.toggle("hidden", isOpen);
      menuIcon.classList.toggle("hidden", !isOpen);
      closeIcon.classList.toggle("hidden", isOpen);
    });
  }
</script>
