---
// UploadRight Exam Preset Directory
// Clean, authoritative cards linking to dedicated tools
import presets from '../data/presets.json';
---

<section id="directory" class="py-16 sm:py-20 bg-white border-t border-[#D9D9DE]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-10">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-[#F0F6FE] border border-[#0062FF]/20 rounded-full text-xs font-semibold text-[#0062FF] uppercase tracking-wider">
        Official Exam Kits
      </div>
      <h2 class="text-2xl sm:text-3xl font-bold text-[#101013] tracking-tight">
        Verified Presets for Indian Government & Recruitment Portals
      </h2>
      <p class="text-sm text-[#626274] leading-relaxed">
        Each kit is pre-configured with exact pixel dimensions, mandatory file size ranges, DPI headers, and official portal specifications.
      </p>
    </div>

    <!-- 4-column responsive grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
      {presets.map((preset) => {
        const photoSlot = preset.slots.find(s => s.docType === 'photo') || preset.slots[0];
        const signatureSlot = preset.slots.find(s => s.docType === 'signature');
        
        return (
          <a
            href={`/${preset.slug}`}
            class="group p-5 rounded-2xl bg-[#F7F7F8] border border-[#D9D9DE] hover:border-[#0062FF] hover:bg-white hover:shadow-sm transition-all flex flex-col justify-between space-y-4"
          >
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <span class="px-2.5 py-0.5 rounded text-[11px] font-bold uppercase tracking-wider bg-[#F0F6FE] text-[#0062FF]">
                  {preset.exam}
                </span>
                <span class="text-xs font-mono text-[#626274]">
                  {preset.slots.length} {preset.slots.length === 1 ? 'Slot' : 'Slots'}
                </span>
              </div>

              <div>
                <h3 class="text-base font-bold text-[#101013] group-hover:text-[#0062FF] transition-colors leading-snug">
                  {preset.title}
                </h3>
                <p class="text-xs text-[#626274] line-clamp-2 mt-1">
                  {preset.description}
                </p>
              </div>

              <!-- Technical specs preview in Geist Mono -->
              <div class="pt-2 border-t border-[#D9D9DE] space-y-1.5 text-[11px] font-mono text-[#626274]">
                <div class="flex justify-between">
                  <span>Photo:</span>
                  <span class="font-semibold text-[#101013]">{photoSlot.widthPx}×{photoSlot.heightPx} px ({photoSlot.minKB}–{photoSlot.maxKB} KB)</span>
                </div>
                {signatureSlot && (
                  <div class="flex justify-between">
                    <span>Signature:</span>
                    <span class="font-semibold text-[#101013]">{signatureSlot.widthPx}×{signatureSlot.heightPx} px ({signatureSlot.minKB}–{signatureSlot.maxKB} KB)</span>
                  </div>
                )}
                <div class="flex justify-between text-[10px]">
                  <span>Resolution:</span>
                  <span class="text-[#0062FF] font-semibold">{photoSlot.dpi} DPI JFIF</span>
                </div>
              </div>
            </div>

            <div class="flex items-center gap-1 text-xs font-semibold text-[#0062FF] group-hover:translate-x-0.5 transition-transform">
              <span>Open Resizer Studio</span>
              <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <polyline points="9 18 15 12 9 6" />
              </svg>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
