---
// RelatedToolsGrid.astro — Matches Figma Color-Block & White Cards Design
import presets from '../data/presets.json';

interface Props {
  currentCategory?: string;
  currentSlug?: string;
  showAll?: boolean;
}

const { currentCategory = 'central', currentSlug = '', showAll = false } = Astro.props;

// Filter related presets by category, excluding current slug
let related = presets.filter(p => p.category === currentCategory && p.slug !== currentSlug);
if (related.length < 6) {
  const others = presets.filter(p => p.slug !== currentSlug && !related.some(r => r.slug === p.slug));
  related = [...related, ...others].slice(0, 6);
} else {
  related = related.slice(0, 6);
}

const displayedPresets = showAll ? presets : related;

const categoryNames: Record<string, string> = {
  central: 'Central Government',
  banking: 'Banking & Financial',
  police: 'Police & Defense',
  state: 'State PSC',
  judiciary: 'Judiciary & High Court',
  others: 'Entrance & PAN Cards'
};

const categoryLabel = categoryNames[currentCategory] || 'Government';
---

<section id="all-exams-grid-section" class="max-w-6xl mx-auto px-4 sm:px-6 my-12 sm:my-16">
  <!-- Figma Color-Block Container (Exact Match to User Reference) -->
  <div class="bg-[#dceeb1] rounded-3xl p-8 sm:p-12 border-2 border-black space-y-8">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 border-b-2 border-black/10 pb-6">
      <div class="space-y-2 max-w-2xl">
        <span class="text-xs font-mono uppercase font-bold tracking-wider text-black block">
          {showAll ? '// 2026 OFFICIAL RECRUITMENT DIRECTORY' : `// RELATED ${categoryLabel.toUpperCase()} WORKSPACES`}
        </span>
        <h2 class="text-2xl sm:text-4xl font-black text-black tracking-tight">
          {showAll ? 'Supported Exam Portals' : `Also Resize for ${categoryLabel} Exams`}
        </h2>
        <p class="text-xs sm:text-sm text-neutral-800 leading-relaxed font-sans">
          {showAll
            ? 'Engineered to remove all guesswork from government portal photo uploads. Pick any exam to launch its official specification kit.'
            : `Preparing for multiple recruitment exams? Launch any official ${categoryLabel.toLowerCase()} workspace with verified requirements.`}
        </p>
      </div>

      {showAll && (
        <div class="text-xs font-mono font-bold text-black shrink-0 px-3.5 py-1.5 rounded-full bg-white border-2 border-black shadow-xs">
          {presets.length} Official Portals
        </div>
      )}
    </div>

    {showAll && (
      <div class="space-y-4">
        <!-- Category Filter Chips -->
        <div class="flex items-center gap-2 flex-wrap text-xs font-mono">
          <button type="button" class="exam-grid-cat-btn px-4 py-1.5 rounded-full bg-black text-white font-bold border-2 border-black transition cursor-pointer" data-cat="all">
            All ({presets.length})
          </button>
          <button type="button" class="exam-grid-cat-btn px-4 py-1.5 rounded-full bg-white hover:bg-black hover:text-white border-2 border-black text-black font-semibold transition cursor-pointer" data-cat="central">
            Central Govt
          </button>
          <button type="button" class="exam-grid-cat-btn px-4 py-1.5 rounded-full bg-white hover:bg-black hover:text-white border-2 border-black text-black font-semibold transition cursor-pointer" data-cat="banking">
            Banking
          </button>
          <button type="button" class="exam-grid-cat-btn px-4 py-1.5 rounded-full bg-white hover:bg-black hover:text-white border-2 border-black text-black font-semibold transition cursor-pointer" data-cat="police">
            Police &amp; Defense
          </button>
          <button type="button" class="exam-grid-cat-btn px-4 py-1.5 rounded-full bg-white hover:bg-black hover:text-white border-2 border-black text-black font-semibold transition cursor-pointer" data-cat="state">
            State PSC
          </button>
          <button type="button" class="exam-grid-cat-btn px-4 py-1.5 rounded-full bg-white hover:bg-black hover:text-white border-2 border-black text-black font-semibold transition cursor-pointer" data-cat="others">
            Entrance &amp; PAN
          </button>
        </div>

        <!-- Live Search Bar -->
        <div class="relative max-w-md">
          <span class="absolute left-3.5 top-3 text-neutral-500 text-xs">🔍</span>
          <input
            type="text"
            id="exam-grid-search-input"
            placeholder="Search exams (e.g. IBPS, SSC, UPSC, Railway, Police)..."
            class="w-full pl-9 pr-4 py-2.5 bg-white border-2 border-black rounded-2xl text-xs font-mono placeholder:text-neutral-500 focus:outline-none transition shadow-xs"
          />
        </div>
      </div>
    )}

    <!-- Cards Grid (3 Columns, clean white cards matching user's Figma reference) -->
    <div id="exam-grid-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {displayedPresets.map((p, idx) => (
        <a
          href={`/${p.slug}`}
          class="exam-box-card bg-white p-6 sm:p-7 rounded-2xl border-2 border-black space-y-4 hover:-translate-y-1 hover:shadow-md transition-all flex flex-col justify-between group cursor-pointer"
          data-category={p.category}
          data-title={(p.shortTitle || p.exam).toLowerCase()}
          data-search={`${p.shortTitle || ''} ${p.exam} ${p.category} ${p.categoryLabel} ${p.slug}`.toLowerCase()}
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="w-8 h-8 rounded-full bg-black text-white font-mono text-sm flex items-center justify-center font-bold">
                {idx + 1}
              </span>
              <span class="text-[10px] font-mono font-bold uppercase px-2.5 py-0.5 rounded-full bg-[#f7f7f5] text-black border border-black/15">
                {p.slots.length}-in-1 Kit
              </span>
            </div>

            <div>
              <h3 class="text-base sm:text-lg font-bold text-black group-hover:underline leading-snug">
                {p.shortTitle || p.exam}
              </h3>
              <p class="text-xs sm:text-sm text-neutral-600 leading-relaxed line-clamp-2 mt-1.5">
                {p.description}
              </p>
            </div>
          </div>

          <div class="pt-3 border-t border-[#f1f1f1] flex items-center justify-between text-xs font-bold text-black font-mono">
            <span class="text-neutral-500 font-normal">{p.slots[0].dpi}&nbsp;DPI · {(p.slots[0].format || 'JPG').toUpperCase()}</span>
            <span class="group-hover:translate-x-1 transition-transform flex items-center gap-1">
              Open Studio →
            </span>
          </div>
        </a>
      ))}
    </div>

    <!-- Empty Search State -->
    <div id="exam-grid-empty" class="hidden text-center py-12 bg-white rounded-2xl border-2 border-black p-8 space-y-2">
      <span class="text-2xl block">🔍</span>
      <h3 class="text-base font-bold text-black">No matching exams found</h3>
      <p class="text-xs font-mono text-neutral-600">Try searching for IBPS, SSC, UPSC, Railway, Police, or NEET</p>
    </div>

    {!showAll && (
      <div class="text-center pt-2">
        <a
          href="/supported"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white border-2 border-black text-xs font-mono font-bold text-black hover:bg-black hover:text-white transition shadow-xs"
        >
          <span>View all {presets.length} official exam bundles</span>
          <span>→</span>
        </a>
      </div>
    )}
  </div>
</section>

{showAll && (
  <script>
    const searchInput = document.getElementById('exam-grid-search-input') as HTMLInputElement | null;
    const catBtns = document.querySelectorAll('.exam-grid-cat-btn');
    const cards = document.querySelectorAll('.exam-box-card');
    const emptyState = document.getElementById('exam-grid-empty');

    let currentCat = 'all';
    let searchQuery = '';

    function filterGrid() {
      let visibleCount = 0;
      cards.forEach(card => {
        const c = card as HTMLElement;
        const cat = c.dataset.category || '';
        const search = c.dataset.search || '';
        
        let catMatch = currentCat === 'all';
        if (!catMatch) {
          if (currentCat === 'central') {
            catMatch = cat === 'central' || cat === 'ssc' || cat === 'upsc';
          } else if (currentCat === 'banking') {
            catMatch = cat === 'banking';
          } else if (currentCat === 'police') {
            catMatch = cat === 'police';
          } else if (currentCat === 'state') {
            catMatch = cat === 'state';
          } else if (currentCat === 'others') {
            catMatch = cat === 'nta' || cat === 'govtid';
          } else {
            catMatch = cat === currentCat;
          }
        }

        const searchMatch = !searchQuery || search.includes(searchQuery);
        const isVisible = catMatch && searchMatch;
        c.classList.toggle('hidden', !isVisible);
        if (isVisible) visibleCount++;
      });

      if (emptyState) {
        emptyState.classList.toggle('hidden', visibleCount > 0);
      }
    }

    if (searchInput) {
      searchInput.addEventListener('input', () => {
        searchQuery = searchInput.value.trim().toLowerCase();
        filterGrid();
      });
    }

    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        catBtns.forEach(b => {
          b.className = 'exam-grid-cat-btn px-4 py-1.5 rounded-full bg-white hover:bg-black hover:text-white border-2 border-black text-black font-semibold transition cursor-pointer';
        });
        btn.className = 'exam-grid-cat-btn px-4 py-1.5 rounded-full bg-black text-white font-bold border-2 border-black transition cursor-pointer';
        currentCat = (btn as HTMLElement).dataset.cat || 'all';
        filterGrid();
      });
    });
  </script>
)}
