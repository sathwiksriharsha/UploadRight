---
// UploadRight Official Specifications Matrix
// Comprehensive, accurate data table for applicants
import presets from '../data/presets.json';
---

<section id="requirements" class="py-12 sm:py-16 bg-white border-t border-[#E5E5EA]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 space-y-6">
    <div class="text-center space-y-2">
      <h2 class="text-xl sm:text-2xl font-bold text-[#1D1D1F] tracking-tight">
        Official Examination Specifications
      </h2>
      <p class="text-xs sm:text-sm text-[#86868B] max-w-lg mx-auto">
        Verified dimensions, KB thresholds, and resolution rules for active recruitment cycles.
      </p>
    </div>

    <!-- Responsive Table Card -->
    <div class="bg-white rounded-2xl border border-[#E5E5EA] overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-xs">
          <thead>
            <tr class="bg-[#F7F7F8] border-b border-[#D9D9DE] text-[#626274] font-semibold">
              <th class="py-3.5 px-4 sm:px-6">Examination / Portal</th>
              <th class="py-3.5 px-4">Document Slot</th>
              <th class="py-3.5 px-4 font-mono">Pixel Dimensions</th>
              <th class="py-3.5 px-4 font-mono">File Size (KB)</th>
              <th class="py-3.5 px-4 font-mono">DPI Header</th>
              <th class="py-3.5 px-4 sm:px-6">Mandatory Background</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[#D9D9DE] text-[#101013]">
            {presets.flatMap((preset) =>
              preset.slots.map((slot, index) => (
                <tr class="hover:bg-[#F0F6FE]/30 transition-colors">
                  {index === 0 ? (
                    <td class="py-3 px-4 sm:px-6 font-bold text-xs" rowspan={preset.slots.length}>
                      <a href={`/${preset.slug}`} class="text-[#0062FF] hover:underline">
                        {preset.exam}
                      </a>
                      <span class="block text-[10px] text-[#626274] font-normal">{preset.categoryLabel}</span>
                    </td>
                  ) : null}
                  <td class="py-3 px-4 font-medium text-xs">
                    {slot.label}
                  </td>
                  <td class="py-3 px-4 font-mono font-semibold">
                    {slot.widthPx} × {slot.heightPx} px
                    {slot.physicalSize && <span class="block text-[10px] text-[#626274] font-normal">{slot.physicalSize}</span>}
                  </td>
                  <td class="py-3 px-4 font-mono">
                    <span class="px-2 py-0.5 rounded bg-[#F7F7F8] border border-[#D9D9DE] font-semibold">
                      {slot.minKB}–{slot.maxKB} KB
                    </span>
                  </td>
                  <td class="py-3 px-4 font-mono text-[#0062FF] font-semibold whitespace-nowrap">
                    {slot.dpi}&nbsp;DPI
                  </td>
                  <td class="py-3 px-4 sm:px-6 text-[#626274] text-[11px]">
                    {slot.background}
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
